        "faq_item_x9QAtd": {
          "type": "faq_item",
          "name": "Returns & Orders",
          "settings": {
            "question": "What is your return policy?",
            "answer": "Returns must be initiated within 5 days of confirmed delivery.\n\nThe item must be brand new, unused and in its original packaging. A 15% restocking fee applies to non-defective returns.\n\nReturn shipping is the buyer's responsibility unless we made an error with your order.\nYou must contact sales@kestrelknives.com before returning anything. Unauthorized returns will not be accepted.\n\nWe also recommend insuring the shipment. If a return is lost or damaged on its way back to us, we can't issue a refund for an item we didn't receive in its original condition.",
            "category": "Returns & Orders",
            "show_item": true
          }
        },
        "faq_item_TfGaTf": {
          "type": "faq_item",
          "name": "Returns & Orders",
          "settings": {
            "question": "Can I return a knife after I've used it?",
            "answer": "No.\n\nA standard return needs to come back brand new and unused. Once a knife has been used, sharpened, modified or carried enough to show wear, we can't sell it as new again.\n\nIf you're having an actual issue with the knife that you believe is a manufacturing defect, contact us and we'll handle that through the warranty process.",
            "category": "Returns & Orders",
            "show_item": true
          }
        },
