          "name": "Returns & Orders",
          "settings": {
            "question": "What items are non-returnable?",
            "answer": "Custom knives, Build-A-Knife orders, sale or discounted items, gift cards and products sold \"as is\" are final sale.\n\nManufacturing defects are handled separately through our warranty process.",
            "category": "Returns & Orders",
            "show_item": true
          }
        },
