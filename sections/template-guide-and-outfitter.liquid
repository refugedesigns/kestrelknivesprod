  <picture>
    <source
      media='(max-width: 749px)'
      srcset='{{ 'guide_and_outfitter_background-750.webp' | asset_url }}'
      type='image/webp'
    >
    <source
      media='(max-width: 1099px)'
      srcset='{{ 'guide_and_outfitter_background.webp' | asset_url }}'
      type='image/webp'
    >
    <source
      srcset='{{ 'guide_and_outfitter_background-1400.webp' | asset_url }}'
      type='image/webp'
    >
    <img
      class='guide-outfitter-form-section__bg'
      src='{{ 'guide_and_outfitter_background.jpg' | asset_url }}'
      alt=''
      width='1400'
      height='787'
      loading='eager'
      fetchpriority='high'
      decoding='async'
