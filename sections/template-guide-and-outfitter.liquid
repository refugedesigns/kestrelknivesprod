<div class='text-center mt-24 mb-12 border-b border-gray-200 pb-8'>
  <h1
    id='guide-outfitter-header'
    class='text-3xl md:text-4xl font-bold text-gray-900 mb-4'
  >
    {{ section.settings.page_title | default: 'Guide and Outfitter Application' }}
  </h1>
  <p class='text-gray-700 text-lg'>
    {{ section.settings.subtitle | default: 'Join our network of professional guides and outfitters' }}
  </p>
</div>

<style>
  .guide-outfitter-form-section {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    width: 100%;
  }
  .guide-outfitter-form-section__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 0;
    pointer-events: none;
  }
  .guide-outfitter-form-section__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: rgba(0, 0, 0, 0.3);
    pointer-events: none;
  }
  .guide-outfitter-form-section__content {
    position: relative;
    z-index: 2;
    max-width: 56rem;
    margin-left: auto;
    margin-right: auto;
    padding: 2rem;
    border-radius: 0.5rem;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
    overflow: visible;
    pointer-events: auto;
  }
  .guide-outfitter-form-section__content::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: inherit;
    background: rgba(255, 255, 255, 0.4);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
    pointer-events: none;
  }
  .guide-outfitter-form-section__form {
    position: relative;
    z-index: 1;
    width: 100%;
    /* Reserve space before Pify posts real height (CLS); do not lock height */
    min-height: 520px;
    pointer-events: auto;
  }
  .guide-outfitter-form-section__form.pifyform,
  .guide-outfitter-form-section__form.pifyform iframe {
    position: relative;
    z-index: 1;
    pointer-events: auto;
  }
  .guide-outfitter-form-section__form.pifyform.formloading iframe {
    visibility: hidden !important;
  }
  .guide-outfitter-form-section__form.pifyform.formloading {
    background-image: url(https://form-builder.pifyapp.com/assets/images/loading.gif?v=4.6);
    background-position: center 30px;
    background-size: 30px 30px;
    background-repeat: no-repeat;
  }
</style>

