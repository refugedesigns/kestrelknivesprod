{% comment %}
  Warranty page template.
  Renders page content like the default page/privacy template,
  with a Contact Us CTA below the content.
{% endcomment %}

{% liquid
  assign cta_label = section.settings.cta_label | default: 'Contact Us'
  assign cta_url = section.settings.cta_url | default: pages.contact.url | default: '/pages/contact'
%}

<style>
  .warranty-content ul,
  .warranty-content ol {
    margin: 0 0 1rem;
    padding-left: 1.5rem;
  }

  .warranty-content ul {
    list-style-type: disc;
  }

  .warranty-content ol {
    list-style-type: decimal;
  }

  .warranty-content li {
    margin: 0.35rem 0;
    line-height: 1.6;
    display: list-item;
  }

  .warranty-content p {
    margin: 0 0 1rem;
    line-height: 1.7;
  }

  .warranty-content h1,
  .warranty-content h2,
  .warranty-content h3,
  .warranty-content h4 {
    color: #111827;
    font-weight: 700;
    line-height: 1.3;
    margin: 1.5rem 0 0.75rem;
  }

  .warranty-content h1 { font-size: 1.875rem; }
  .warranty-content h2 { font-size: 1.5rem; }
  .warranty-content h3 { font-size: 1.25rem; }

  .warranty-content a {
    color: #111827;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .warranty-content strong,
  .warranty-content b {
    font-weight: 700;
  }
</style>

{% if section.settings.header_image != blank %}
  <div class='relative w-full overflow-hidden'>
    {% liquid
      assign object_position = 'object-center'
      case section.settings.header_position
        when 'top'
          assign object_position = 'object-top'
        when 'bottom'
          assign object_position = 'object-bottom'
      endcase
    %}

    <div
      class='w-full'
      style='height: {{ section.settings.header_image_height_mobile | default: 300 }}px;'
    >
      <img
        src='{{ section.settings.header_image | image_url: width: 1920 }}'
        alt='{{ section.settings.header_alt | default: page.title | escape }}'
        class='w-full h-full object-cover {{ object_position }}'
        width='{{ section.settings.header_image.width | default: 1920 }}'
        height='{{ section.settings.header_image.height | default: 400 }}'
        loading='eager'
      >
    </div>

    <style>
      @media (min-width: 768px) {
        .relative.w-full.overflow-hidden > div:first-child {
          height: {{ section.settings.header_image_height | default: 400 }}px !important;
        }
      }
    </style>

    <div class='absolute inset-0 bg-black/20'></div>
  </div>

  <div class='max-w-4xl mx-auto px-4 py-6 md:py-8'>
    <div class='warranty-content prose prose-lg max-w-none'>
      {{ page.content }}
    </div>

    {% if section.settings.show_cta %}
      <div class='mt-10 md:mt-12 text-center'>
        <a
          href='{{ cta_url }}'
          class='inline-block bg-black hover:bg-gray-900 text-white font-semibold uppercase tracking-wide px-8 py-3 transition-colors duration-200'
        >
          {{ cta_label }}
        </a>
      </div>
    {% endif %}
  </div>
{% else %}
  <div class='bg-gray-50'>
    <header
      class='text-white relative overflow-hidden flex items-center justify-center'
      style='background-color: {{ section.settings.header_bg_color | default: "#000000" }}; min-height: {{ section.settings.header_height | default: 200 }}px; padding-top: {{ section.settings.header_padding_top | default: 4 }}rem; padding-bottom: {{ section.settings.header_padding_bottom | default: 4 }}rem; {% if section.settings.header_border_bottom %}border-bottom: 2px solid {{ section.settings.header_border_color | default: "#ffffff" }};{% endif %}'
    >
      <div class='container mx-auto px-4 relative z-10 flex flex-col items-center justify-center'>
        <div class='text-center'>
          <h1
            class='text-5xl font-bold mb-4'
            style='color: {{ section.settings.title_color | default: "#ffffff" }};'
          >
            {{ page.title }}
          </h1>
          {% if page.excerpt != blank %}
            <p class='text-xl opacity-90 max-w-2xl mx-auto leading-relaxed'>
              {{ page.excerpt }}
            </p>
          {% endif %}
        </div>
      </div>
    </header>

    <div class='container mx-auto px-4 py-16'>
      <div class='max-w-4xl mx-auto'>
        <div class='bg-white p-8 md:p-12'>
          <div class='warranty-content prose prose-lg max-w-none'>
            {{ page.content }}
          </div>

          {% if section.settings.show_cta %}
            <div class='mt-10 md:mt-12 text-center'>
              <a
                href='{{ cta_url }}'
                class='inline-block bg-black hover:bg-gray-900 text-white font-semibold uppercase tracking-wide px-8 py-3 transition-colors duration-200'
              >
                {{ cta_label }}
              </a>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Warranty Page",
  "tag": "section",
  "class": "section-warranty",
  "settings": [
    {
      "type": "header",
      "content": "Contact CTA"
    },
    {
      "type": "checkbox",
      "id": "show_cta",
      "label": "Show Contact Us button",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Contact Us"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button link",
      "info": "Defaults to the Contact page if left blank."
    },
    {
      "type": "header",
      "content": "Header Image"
    },
    {
      "type": "image_picker",
      "id": "header_image",
      "label": "Header image"
    },
    {
      "type": "text",
      "id": "header_alt",
      "label": "Header image alt text",
      "default": "Warranty"
    },
    {
      "type": "range",
      "id": "header_image_height",
      "label": "Header image height",
      "min": 200,
      "max": 800,
      "step": 50,
      "default": 400,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "header_image_height_mobile",
      "label": "Header image height - Mobile",
      "min": 150,
      "max": 600,
      "step": 50,
      "default": 300,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "header_position",
      "label": "Image position",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "top", "label": "Top" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Default Header"
    },
    {
      "type": "color",
      "id": "header_bg_color",
      "label": "Header background color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "header_height",
      "label": "Header height",
      "min": 200,
      "max": 600,
      "step": 16,
      "default": 200,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "header_border_bottom",
      "label": "Show bottom border",
      "default": false
    },
    {
      "type": "color",
      "id": "header_border_color",
      "label": "Bottom border color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "header_padding_top",
      "label": "Header padding top",
      "min": 2,
      "max": 8,
      "step": 0.5,
      "default": 4,
      "unit": "rem"
    },
    {
      "type": "range",
      "id": "header_padding_bottom",
      "label": "Header padding bottom",
      "min": 2,
      "max": 8,
      "step": 0.5,
      "default": 4,
      "unit": "rem"
    }
  ],
  "presets": [
    {
      "name": "Warranty Page"
    }
  ]
}
{% endschema %}
