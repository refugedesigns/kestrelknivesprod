<style>
  /* Using Tailwind grid utilities to match template-collection layout */
</style>

<script>
  window.__collectionProducts = [
    {%- for product in collection.products -%}
      {
        "available": {{ product.available | json }},
        "type": {{ product.type | json }},
        "product_type": {{ product.type | json }},
        "tags": {{ product.tags | json }},
        "price": {{ product.price | json }}
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ];
</script>

{% render 'product-card-js' %}

<div class='px-4 py-4 mx-auto' x-data='customCollectionPage()'>
  {% paginate collection.products by section.settings.number_of_products_per_page %}
    <div
      class='text-center mb-8 px-6 py-4 rounded-lg flex items-center justify-center'
      style='background-color: {{ section.settings.page_title_bg_color | default: "#ffffff" }};'
    >
      <h1
        class='text-xl md:text-4xl font-bold text-gray-900 mb-4'
        style='color: {{ section.settings.page_title_color | default: "#000000" }};'
      >
        {{ section.settings.page_title | default: "Hidden Offer" }}
      </h1>
    </div>

    <div class='max-w-6xl mx-auto'>
      {%- comment -%} Product count removed {%- endcomment -%}

      <!-- Products Grid -->
      <div
        id='products-grid'
        class='grid grid-cols-2 md:grid-cols-4 gap-2 md:gap-8'
      >
        {% assign hidden_offer_count = 0 %}
        {% assign kk_card_n = 0 %}
        {% assign rendered_ids = "," %}

        {% comment %}
          Early access / Hidden Offer page: sort by early_access_position_N only
          (independent of knives collection product_N / position_N tags).
          Only render products tagged hidden_offer.
        {% endcomment %}
        {% for i in (1..999) %}
          {% assign wanted = "early_access_position_" | append: i %}
          {% assign wanted_token = "||" | append: wanted | append: "||" %}
          {% for product in collection.products %}
            {%- assign tags_hidden_check = product.tags
              | join: "||"
              | downcase
              | replace: "-", "_"
              | replace: " ", "_"
            -%}
            {%- assign tags_hidden_check = "||"
              | append: tags_hidden_check
              | append: "||"
            -%}
            {% if tags_hidden_check contains "||hidden_offer||"
              and tags_hidden_check contains wanted_token
            %}
              {% assign kk_card_n = kk_card_n | plus: 1 %}
              {% if kk_card_n <= 4 %}
                {% render "product-card", product_product: product, card_priority: true %}
              {% else %}
                {% render "product-card", product_product: product %}
              {% endif %}
              {% assign rendered_ids = rendered_ids
                | append: product.id
                | append: ","
              %}
              {% assign hidden_offer_count = hidden_offer_count | plus: 1 %}
            {% endif %}
          {% endfor %}
        {% endfor %}

        {%- comment -%} Remaining hidden_offer products without early_access_position_N {%- endcomment -%}
        {% for product in collection.products %}
          {% assign pid = product.id | append: "," %}
          {% unless rendered_ids contains pid %}
            {%- assign tags_hidden_check = product.tags
              | join: "||"
              | downcase
              | replace: "-", "_"
              | replace: " ", "_"
            -%}
            {%- assign tags_hidden_check = "||"
              | append: tags_hidden_check
              | append: "||"
            -%}
            {% if tags_hidden_check contains "||hidden_offer||" %}
              {% assign kk_card_n = kk_card_n | plus: 1 %}
              {% if kk_card_n <= 4 %}
                {% render "product-card", product_product: product, card_priority: true %}
              {% else %}
                {% render "product-card", product_product: product %}
              {% endif %}
              {% assign hidden_offer_count = hidden_offer_count | plus: 1 %}
            {% endif %}
          {% endunless %}
        {% endfor %}

        {% if hidden_offer_count == 0 %}
          <div class='col-span-full text-center py-12'>
            <p class='text-gray-500 text-lg'>
              There are no products in this collection
            </p>
          </div>
        {% endif %}
      </div>

      <!-- Pagination -->
      {% if paginate.pages > 1 %}
        <div class='mt-12'>
          {% render "pagination", pagination: paginate %}
        </div>
      {% endif %}
    </div>
  {% endpaginate %}
</div>

<script>
  function customCollectionPage() {
    return {
      init() {},
    }
  }
</script>

{% schema %}
{
  "name": "Custom Collection",
  "settings": [
    {
      "type": "header",
      "content": "Page Title"
    },
    {
      "type": "text",
      "id": "page_title",
      "label": "Page Title",
      "default": "Guide & Outfitter Early Access"
    },
    {
      "type": "color",
      "id": "page_title_color",
