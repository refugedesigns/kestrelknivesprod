{% liquid
  assign desktop_collection = section.settings.featured_collection
  assign mobile_collection = section.settings.mobile_collection
  assign tablet_collection = section.settings.tablet_collection
  assign desktop_limit = section.settings.number_of_products_to_show | default: 4
  assign mobile_limit = section.settings.mobile_products_to_show | default: desktop_limit
  assign tablet_limit = section.settings.tablet_products_to_show | default: desktop_limit
  assign mobile_cols = section.settings.mobile_columns | default: 2
  assign tablet_cols = section.settings.tablet_columns | default: 2
  assign desktop_cols = section.settings.desktop_columns | default: 4
  assign show_mobile = false
  assign show_tablet = false
  if mobile_collection != blank and desktop_collection != blank and mobile_collection.id != desktop_collection.id
    assign show_mobile = true
  endif
  if tablet_collection != blank and desktop_collection != blank and tablet_collection.id != desktop_collection.id
    assign show_tablet = true
  endif
  if mobile_collection != blank and tablet_collection != blank and mobile_collection.id == tablet_collection.id and show_mobile
    assign show_tablet = false
  endif
%}

<div class='flex flex-col items-center mt-2 mb-8'>
  <h2 class='text-center text-3xl'>{{ section.settings.title }}</h2>

  <div class='max-w-5xl mx-auto flex flex-col items-center w-full'>
    {% if show_mobile %}
      <div class='block md:hidden w-full'>
        <div
          class='grid w-full gap-2 md:gap-6'
          style='grid-template-columns: repeat({{ mobile_cols }}, 1fr);'
        >
          {% for product in mobile_collection.products limit: mobile_limit %}
            {%- assign tags_lower = product.tags
              | join: "||"
              | downcase
              | split: "||"
            -%}
            {% unless tags_lower contains "hidden_offer" %}
              {% render "product-card-featured", product_product: product %}
            {% endunless %}
          {% else %}
            {% for item in (1..4) %}
              {% render "product-card-placeholder" %}
            {% endfor %}
          {% endfor %}
        </div>
      </div>
    {% endif %}

    {% if show_tablet %}
      <div class='hidden md:block lg:hidden w-full'>
        <div
          class='grid w-full gap-2 md:gap-6'
          style='grid-template-columns: repeat({{ tablet_cols }}, 1fr);'
        >
          {% for product in tablet_collection.products limit: tablet_limit %}
            {%- assign tags_lower = product.tags
              | join: "||"
              | downcase
              | split: "||"
            -%}
            {% unless tags_lower contains "hidden_offer" %}
              {% render "product-card-featured", product_product: product %}
            {% endunless %}
          {% else %}
            {% for item in (1..4) %}
              {% render "product-card-placeholder" %}
            {% endfor %}
          {% endfor %}
        </div>
      </div>
    {% endif %}

    <div
      class='w-full {% if show_mobile and show_tablet %}hidden lg:block{% elsif show_mobile %}hidden md:block{% elsif show_tablet %}md:hidden lg:block{% endif %}'
    >
      <div
        class='grid w-full gap-2 md:gap-6 featured-collection-grid'
        style='--fc-mobile-cols: {{ mobile_cols }}; --fc-tablet-cols: {{ tablet_cols }}; --fc-desktop-cols: {{ desktop_cols }};'
      >
        {% if desktop_collection %}
          {% for product in desktop_collection.products limit: desktop_limit %}
            {%- assign tags_lower = product.tags
              | join: "||"
              | downcase
              | split: "||"
            -%}
            {% unless tags_lower contains "hidden_offer" %}
              {% render "product-card-featured", product_product: product %}
            {% endunless %}
          {% else %}
            {% for item in (1..4) %}
              {% render "product-card-placeholder" %}
            {% endfor %}
          {% endfor %}
        {% else %}
          {% for item in (1..4) %}
            {% render "product-card-placeholder" %}
          {% endfor %}
        {% endif %}
      </div>
    </div>
  </div>
</div>

<style>
  .featured-collection-grid {
    grid-template-columns: repeat(var(--fc-mobile-cols), 1fr);
  }
  @media (min-width: 768px) {
    .featured-collection-grid {
      grid-template-columns: repeat(var(--fc-tablet-cols), 1fr);
    }
  }
  @media (min-width: 1024px) {
    .featured-collection-grid {
      grid-template-columns: repeat(var(--fc-desktop-cols), 1fr);
    }
  }
</style>

{% schema %}
{
  "name": "Featured Collection",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "default": "Featured Collection",
      "label": "Title"
    },
    {
      "type": "collection",
      "id": "featured_collection",
      "label": "Desktop Collection"
    },
    {
      "type": "range",
      "id": "number_of_products_to_show",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 4,
      "label": "Desktop: Number of products to show"
    },
    {
      "type": "header",
      "content": "Mobile Settings"
    },
    {
      "type": "collection",
      "id": "mobile_collection",
      "label": "Mobile Collection",
      "info": "Optional: Use a different collection for mobile. If not set, will use the desktop collection."
    },
    {
      "type": "range",
      "id": "mobile_products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4,
      "label": "Mobile: Number of products to show"
    },
    {
      "type": "range",
      "id": "mobile_columns",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2,
      "label": "Mobile: Number of columns"
    },
    {
      "type": "header",
      "content": "Tablet Settings"
    },
    {
      "type": "collection",
      "id": "tablet_collection",
      "label": "Tablet Collection",
      "info": "Optional: Use a different collection for tablet. If not set, will use the desktop collection."
    },
    {
      "type": "range",
      "id": "tablet_products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4,
      "label": "Tablet: Number of products to show"
    },
    {
      "type": "range",
      "id": "tablet_columns",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2,
      "label": "Tablet: Number of columns"
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 4,
      "label": "Desktop: Number of columns"
    },
    {
      "type": "header",
      "content": "Color Variant Images"
    },
    {
      "type": "image_picker",
      "id": "orange_image",
      "label": "Orange Color Image",
      "info": "Upload an image for orange color variants"
    },
    {
      "type": "image_picker",
      "id": "black_orange_image",
      "label": "Black w/Orange Liner Image",
      "info": "Upload an image for black with orange liner variants"
    },
    {
      "type": "image_picker",
      "id": "black_image",
      "label": "Black Color Image",
      "info": "Upload an image for black color variants"
    },
    {
      "type": "image_picker",
      "id": "green_image",
      "label": "Green Color Image",
      "info": "Upload an image for green color variants"
    },
    {
      "type": "image_picker",
      "id": "camo_image",
      "label": "Camo/Earth Color Image",
      "info": "Upload an image for camo or earth color variants"
    },
    { "type": "header", "content": "Card color override images" },
    {
      "type": "image_picker",
      "id": "high_vis_orange_image",
      "label": "High Vis Orange Image"
    },
    {
      "type": "image_picker",
      "id": "high_vis_green_image",
      "label": "High Vis Green Image"
    }
  ],
  "presets": [
    {
      "name": "Featured Collection"
    }
  ]
}
{% endschema %}
