<!doctype html>
<html lang='{{ request.locale.iso_code | default: shop.locale }}'>
  <head>
    <title>{{ page_title }}{% unless page_title contains shop.name %} — {{ shop.name }}{% endunless %}</title>
    <meta charset='utf-8'>
    <meta http-equiv='X-UA-Compatible' content='IE=edge,chrome=1'>
    <meta
      name='viewport'
      content='width=device-width,initial-scale=1,shrink-to-fit=no'
    >
    <meta name='description' content='{{ page_description | default: shop.name | escape }}'>
    <meta name='robots' content='noindex,nofollow'>
    <link rel='canonical' href='{{ canonical_url }}'>

    <link rel='dns-prefetch' href='https://cdn.shopify.com'>

    {{ content_for_header }}
    <!-- Header hook for plugins -->
    {{ "application.css" | asset_url | stylesheet_tag }}
    <script src='{{ "application.js" | asset_url }}' defer></script>
    <script src='{{ "alpine.min.js" | asset_url }}' defer></script>

    <style>
      [x-cloak] {
        display: none;
      }
    </style>
  </head>
  <body>
    {% section "header" %}
    <main role='main'>
      {{ content_for_layout }}
    </main>
  </body>
</html>
