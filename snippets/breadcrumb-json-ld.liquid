{% comment %}
  BreadcrumbList JSON-LD only. No visible breadcrumb markup.
  Product pages use the collection from the URL unless it is an internal one,
  otherwise ultralight-knives / apparels / accessories, otherwise the first
  non-internal collection. Collection pages list Home and that collection.
{% endcomment %}
{% liquid
  assign crumb_collection = nil
  if template.name == 'product'
    # Internal/merchandising collections never become the crumb. Prefer the
    # main shop collections, then any other public collection.
    assign crumb_skip = 'featured,featured-mobile,eastmans-offer,all,frontpage,early-access,most-popular-apparel,most-popular-sweatshirts,pinterest-apparel-stickers,custom' | split: ','
    assign crumb_preferred = 'ultralight-knives,apparels,accessories' | split: ','
    if collection != blank
      unless crumb_skip contains collection.handle
        assign crumb_collection = collection
      endunless
    endif
    if crumb_collection == blank
      for preferred_handle in crumb_preferred
        for c in product.collections
          if c.handle == preferred_handle
            assign crumb_collection = c
            break
          endif
        endfor
        if crumb_collection != blank
          break
        endif
      endfor
    endif
    if crumb_collection == blank
      for c in product.collections
        unless crumb_skip contains c.handle
          assign crumb_collection = c
          break
        endunless
      endfor
    endif
  elsif template.name == 'collection'
    assign crumb_collection = collection
  endif
%}
{%- if template.name == 'product' or template.name == 'collection' -%}
  <script type='application/ld+json'>
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": {{ shop.name | json }},
          "item": {{ shop.url | json }}
        }
        {%- if crumb_collection != blank -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ crumb_collection.title | json }},
            "item": {{ shop.url | append: crumb_collection.url | json }}
          }
        {%- endif -%}
        {%- if template.name == 'product' -%}
          ,{
            "@type": "ListItem",
            "position": {% if crumb_collection != blank %}3{% else %}2{% endif %},
            "name": {{ product.title | json }},
            "item": {{ shop.url | append: product.url | json }}
          }
        {%- endif -%}
      ]
    }
  </script>
{%- endif -%}
