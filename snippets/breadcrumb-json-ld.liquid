{% comment %}
  BreadcrumbList JSON-LD only. No visible breadcrumb markup.
  Product pages use the collection from the URL when present, otherwise the
  product's first collection. Collection pages list Home and that collection.
{% endcomment %}
{% liquid
  assign crumb_collection = nil
  if template.name == 'product'
    if collection != blank
      assign crumb_collection = collection
    else
      assign crumb_collection = product.collections.first
    endif
  elsif template.name == 'collection'
    assign crumb_collection = collection
  endif
%}
{%- if template.name == 'product' or template.name == 'collection' -%}
  <script type='application/ld+json'>
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": {{ shop.name | json }},
          "item": {{ shop.url | json }}
        }
        {%- if crumb_collection != blank -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ crumb_collection.title | json }},
            "item": {{ shop.url | append: crumb_collection.url | json }}
          }
        {%- endif -%}
        {%- if template.name == 'product' -%}
          ,{
            "@type": "ListItem",
            "position": {% if crumb_collection != blank %}3{% else %}2{% endif %},
            "name": {{ product.title | json }},
            "item": {{ shop.url | append: product.url | json }}
          }
        {%- endif -%}
      ]
    }
  </script>
{%- endif -%}
