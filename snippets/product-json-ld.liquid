{% comment %}
  Product JSON-LD. selected_variant is passed from the product section so the
  product-level SKU follows the same variant as the page, including sold-out
  deep links. Review totals come from Klaviyo's Shopify review metafields.
  Offers point at the store-wide return and shipping policies by @id. Those
  are defined in snippets/merchant-policies-json-ld.liquid and output in the
  Organization JSON-LD in layout/theme.liquid on product pages.
{% endcomment %}
{% liquid
  assign schema_variant = selected_variant
  if schema_variant == blank
    assign schema_variant = product.selected_variant | default: product.selected_or_first_available_variant
  endif

  assign brand_name = product.vendor | strip
  if brand_name == blank
    assign brand_name = shop.name
  endif

  # reviews.rating is a Shopify rating metafield: .value is a rating object,
  # so output its .rating, .scale_max and .scale_min (not the object itself).
  assign rating_obj = product.metafields.reviews.rating.value
  assign rating_value = rating_obj.rating
  assign rating_best = rating_obj.scale_max | default: 5
  assign rating_worst = rating_obj.scale_min | default: 1
  assign rating_count = product.metafields.reviews.rating_count.value
  if rating_count == blank
    assign rating_count = product.metafields.reviews.rating_count
  endif
  assign rating_count_number = rating_count | plus: 0

  assign has_rating = false
  if rating_count_number > 0 and rating_value != blank
    assign has_rating = true
  endif

  # Merchant listings need price > 0, so skip offers for $0 products
  # (e.g. knife-sharpening) and skip the whole Product if nothing qualifies.
  assign has_offers = false
  if product.price_max > 0
    assign has_offers = true
  endif

  assign schema_sku = schema_variant.sku | strip

  # Final-sale items in the refund policy can't be returned: custom and
  # Build-A-Knife knives, gift cards, sale items (checked per variant below)
  # and anything tagged final-sale (e.g. as-is / blemished knives).
  assign policy_page_url = shop.url | append: '/pages/shipping-returns'
  assign shipping_policy_id = policy_page_url | append: '#shipping-policy'
  assign product_final_sale = false
  assign product_type_down = product.type | downcase
  if product_type_down == 'custom' or product.handle contains 'build-your-knife' or product.gift_card? or product.tags contains 'final-sale'
    assign product_final_sale = true
  endif
%}
{%- if has_offers or has_rating -%}
<script type='application/ld+json'>
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": {{ product.title | json }},
    "description": {{ product.description | strip_html | strip | json }},
    "url": {{ shop.url | append: product.url | json }}
    {%- if product.images.size > 0 -%}
      ,"image": [
        {%- for image in product.images -%}
          {%- assign img_url = image | image_url: width: 1200 -%}
          {%- unless img_url contains '://' -%}
            {%- assign img_url = img_url | prepend: 'https:' -%}
          {%- endunless -%}
          {{ img_url | json }}{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    {%- endif -%}
    ,"brand": {
      "@type": "Brand",
      "name": {{ brand_name | json }}
    }
    {%- if schema_sku != blank -%}
      {%- unless schema_sku contains ' ' -%}
        ,"sku": {{ schema_sku | json }}
      {%- endunless -%}
    {%- endif -%}
    {%- if has_rating -%}
      ,"aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": {{ rating_value | plus: 0 | json }},
        "reviewCount": {{ rating_count_number | json }},
        "bestRating": {{ rating_best | plus: 0 | json }},
        "worstRating": {{ rating_worst | plus: 0 | json }}
      }
    {%- endif -%}
    {%- if has_offers -%}
    ,"offers": [
      {%- for variant in product.variants -%}
        {%- assign barcode = variant.barcode | strip -%}
        {%- assign barcode_non_digits = barcode | replace: '0', '' | replace: '1', '' | replace: '2', '' | replace: '3', '' | replace: '4', '' | replace: '5', '' | replace: '6', '' | replace: '7', '' | replace: '8', '' | replace: '9', '' -%}
        {%- assign barcode_length = barcode | size -%}
        {%- assign gtin_property = '' -%}
        {%- if barcode != blank and barcode_non_digits == blank -%}
          {%- if barcode_length == 8 -%}
            {%- assign gtin_property = 'gtin8' -%}
          {%- elsif barcode_length == 12 -%}
            {%- assign gtin_property = 'gtin12' -%}
          {%- elsif barcode_length == 13 -%}
            {%- assign gtin_property = 'gtin13' -%}
          {%- elsif barcode_length == 14 -%}
            {%- assign gtin_property = 'gtin14' -%}
          {%- endif -%}
        {%- endif -%}
        {
          "@type": "Offer",
          "price": {{ variant.price | divided_by: 100.0 | json }},
          "priceCurrency": {{ cart.currency.iso_code | json }},
          "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
          "itemCondition": "https://schema.org/NewCondition",
          "url": {{ shop.url | append: variant.url | json }}
          {%- assign offer_sku = variant.sku | strip -%}
          {%- if offer_sku != blank -%}
            {%- unless offer_sku contains ' ' -%}
              ,"sku": {{ offer_sku | json }}
            {%- endunless -%}
          {%- endif -%}
          {%- if gtin_property != blank -%}
            ,"{{ gtin_property }}": {{ barcode | json }}
          {%- endif -%}
          {%- assign offer_final_sale = product_final_sale -%}
          {%- if variant.compare_at_price > variant.price -%}
            {%- assign offer_final_sale = true -%}
          {%- endif -%}
          {%- if offer_final_sale -%}
            ,"hasMerchantReturnPolicy": {% render 'merchant-policies-json-ld', part: 'final-sale' %}
          {%- else -%}
            ,"hasMerchantReturnPolicy": {% render 'merchant-policies-json-ld', part: 'offer-refs' %}
          {%- endif -%}
          ,"shippingDetails": {
            "@type": "OfferShippingDetails",
            "hasShippingService": { "@id": {{ shipping_policy_id | json }} }
          }
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
    {%- endif -%}
  }
</script>
{%- endif -%}
