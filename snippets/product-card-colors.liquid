{% doc %}
  Compact color list for a product card. Echoes a JSON array of {name, hex}.
  Hex is included for apparel when the option swatch has a color.
  Returns [] when there is nothing to choose, or only one color.

  @param {object} product_product - Product drop
{% enddoc %}
{%- liquid
  assign card_type = product_product.type | default: '' | downcase
  assign is_apparel = false
  assign is_accessory = false
  if card_type contains 'apparel'
    assign is_apparel = true
  endif
  if card_type contains 'accessories'
    assign is_accessory = true
  endif
  assign color_json = ''
  assign color_count = 0
-%}
{%- if is_accessory or product_product.has_only_default_variant -%}
[]
{%- elsif is_apparel -%}
  {%- liquid
    assign color_opt_index = 0
    for option in product_product.options_with_values
      assign option_name_down = option.name | downcase
      if option_name_down contains 'color' or option_name_down contains 'colour' or option_name_down contains 'shade' or option_name_down contains 'finish'
        assign color_opt_index = forloop.index
        break
      endif
    endfor
    if color_opt_index == 0
      assign first_option_name = product_product.options | first | downcase
      unless first_option_name contains 'size' or first_option_name contains 'title'
        assign color_opt_index = 1
      endunless
    endif
  -%}
  {%- if color_opt_index > 0 -%}
    {%- for option in product_product.options_with_values -%}
      {%- if forloop.index == color_opt_index and option.values.size > 1 -%}
        {%- for value in option.values -%}
          {%- liquid
            assign color_label = value.name | default: value
            assign color_hex = ''
            if value.swatch.color != blank
              assign color_hex = value.swatch.color | color_to_hex
            endif
            if color_count > 0
              assign color_json = color_json | append: ','
            endif
            assign color_count = color_count | plus: 1
          -%}
          {%- capture color_piece -%}{"name":{{ color_label | json }}{%- if color_hex != blank -%},"hex":{{ color_hex | json }}{%- endif -}}{%- endcapture -%}
          {%- assign color_json = color_json | append: color_piece -%}
        {%- endfor -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
  {%- if color_count > 1 -%}[{{ color_json }}]{%- else -%}[]{%- endif -%}
{%- else -%}
  {%- assign seen_colors = '' -%}
  {%- for variant in product_product.variants -%}
    {%- if variant.option1 and variant.title != 'Default Title' -%}
      {%- assign color_token = '|' | append: variant.option1 | downcase | append: '|' -%}
      {%- unless seen_colors contains color_token -%}
        {%- liquid
          assign seen_colors = seen_colors | append: color_token
          if color_count > 0
            assign color_json = color_json | append: ','
          endif
          assign color_count = color_count | plus: 1
        -%}
        {%- capture color_piece -%}{"name":{{ variant.option1 | json }}}{%- endcapture -%}
        {%- assign color_json = color_json | append: color_piece -%}
      {%- endunless -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if color_count > 1 -%}[{{ color_json }}]{%- else -%}[]{%- endif -%}
{%- endif -%}
