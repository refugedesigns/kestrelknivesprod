{% comment %}
  Local color swatch image — tries paracord_color_[color].png, then .jpg, then .jpeg.
  Accepts: option_name, value, size (default 64x64), img_class, width, height
{% endcomment %}

{% assign lc_size = size | default: '64x64' %}
{% assign lc_option_token = option_name
  | strip
  | downcase
  | replace: " ", "_"
  | replace: "-", "_"
  | replace: "/", "_"
  | replace: ".", "_"
  | replace: "__", "_"
  | replace: "__", "_"
%}
{% assign lc_value_token = value
  | strip
  | downcase
  | replace: " ", "_"
  | replace: "-", "_"
  | replace: "/", "_"
  | replace: ".", "_"
  | replace: "__", "_"
  | replace: "__", "_"
%}
{% assign lc_asset_base = lc_option_token | append: '_' | append: lc_value_token %}
{% assign lc_png = lc_asset_base | append: '.png' | asset_img_url: lc_size %}
{% assign lc_jpg = lc_asset_base | append: '.jpg' | asset_img_url: lc_size %}
{% assign lc_jpeg = lc_asset_base | append: '.jpeg' | asset_img_url: lc_size %}

<img
  src='{{ lc_png }}'
  alt='{{ value | escape }}'
  {% if img_class != blank %}
    class='{{ img_class }}'
  {% endif %}
  {% if width != blank %}
    width='{{ width }}'
  {% endif %}
  {% if height != blank %}
    height='{{ height }}'
  {% endif %}
  onerror="if(!this.dataset.lcFb){this.dataset.lcFb='jpg';this.src='{{ lc_jpg }}'}else if(this.dataset.lcFb==='jpg'){this.dataset.lcFb='jpeg';this.src='{{ lc_jpeg }}'}"
>
