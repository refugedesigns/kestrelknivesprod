{% comment %}
  Product Card
  This snippet is used to display a product card on the product page.
  It is used to display the product image, title, price, and add to cart button.
  It is also used to display the product variants and their images.
  It is also used to display the product images and their images.
  It is also used to display the product images and their images.
{% endcomment %}
{% assign product_tags_lower = product_product.tags | join: "||" | downcase %}
{% assign has_complex_tag = false %}
{% if product_tags_lower contains "use_complex_options" %}
  {% assign has_complex_tag = true %}
{% endif %}

{% assign product_type_lower = product_product.type | default: "" | downcase %}
{% assign is_apparel = false %}
{% assign is_accessory = false %}
{% assign is_custom = false %}
{% if product_type_lower contains "apparel" %}
  {% assign is_apparel = true %}
{% endif %}
{% if product_type_lower contains "accessories" %}
  {% assign is_accessory = true %}
{% endif %}
{% if product_type_lower contains "custom" %}
  {% assign is_custom = true %}
{% endif %}

{%- comment -%}
  Apparel: show the first variant's image, and select that variant.
  Knives: select the first in-stock variant and show its image.
  Do not follow the product featured image — that photo can belong to a later color.
{%- endcomment -%}
{% assign card_initial_image = nil %}
{% assign card_selected_variant = nil %}
{% if is_apparel %}
  {% assign card_selected_variant = product_product.variants.first %}
{% else %}
  {% for variant in product_product.variants %}
    {% if variant.available %}
      {% assign card_selected_variant = variant %}
      {% break %}
    {% endif %}
  {% endfor %}
{% endif %}
{% if card_selected_variant == nil %}
  {% assign card_selected_variant = product_product.selected_or_first_available_variant %}
{% endif %}
{% if card_selected_variant.featured_image %}
  {% assign card_initial_image = card_selected_variant.featured_image %}
{% endif %}
{% if card_initial_image == blank and product_product.featured_image %}
  {% assign replace_featured_image = false %}
  {% for variant in product_product.variants %}
    {% if variant.featured_image
      and variant.featured_image.id == product_product.featured_image.id
    %}
      {% unless variant.available %}
        {% assign replace_featured_image = true %}
      {% endunless %}
      {% break %}
    {% endif %}
  {% endfor %}
  {% if replace_featured_image %}
    {% for variant in product_product.variants %}
      {% if variant.available and variant.featured_image %}
        {% assign card_initial_image = variant.featured_image %}
        {% break %}
      {% endif %}
    {% endfor %}
    {% if card_initial_image == blank and product_product.images.size > 0 %}
      {% assign card_initial_image = product_product.images[0] %}
    {% endif %}
  {% else %}
    {% assign card_initial_image = product_product.featured_image %}
  {% endif %}
{% elsif product_product.images.size > 0 %}
  {% assign card_initial_image = product_product.images[0] %}
{% endif %}

{%- comment -%}
  First paint stays small. Variant lists load from /products/{handle}.js
  on hover, focus, swatch, add to cart, or quick view.
{%- endcomment -%}
{% assign kk_status = product_product.metafields.custom.product_status
  | default: product_product.metafields.custom_fields.product_status
  | default: product_product.metafields.global.product_status
%}
{%- capture card_images_json -%}
[
{%- for image in product_product.images limit: 2 -%}
  {"id":{{ image.id | json }},"src":{{ image | image_url: width: 400, format: 'webp' | json }}}{%- unless forloop.last -%},{%- endunless -%}
{%- endfor -%}
]
{%- endcapture -%}
{%- capture card_product_json -%}
{"id":{{ product_product.id | json }},"title":{{ product_product.title | json }},"handle":{{ product_product.handle | json }},"url":{{ product_product.url | json }},"type":{{ product_product.type | json }},"product_type":{{ product_product.type | json }},"available":{{ product_product.available | json }},"price":{{ product_product.price | json }},"options":{{ product_product.options | json }},"status":{{ kk_status | json }}}
{%- endcapture -%}
{%- capture card_seed_json -%}
{%- if card_selected_variant -%}
{"id":{{ card_selected_variant.id | json }},"title":{{ card_selected_variant.title | json }},"available":{{ card_selected_variant.available | json }},"price":{{ card_selected_variant.price | json }},"option1":{{ card_selected_variant.option1 | json }},"option2":{{ card_selected_variant.option2 | json }},"option3":{{ card_selected_variant.option3 | json }},"featured_image":null}
{%- else -%}
{}
{%- endif -%}
{%- endcapture -%}
{%- liquid
  assign swatch_type = product_product.type | default: '' | downcase
  assign swatch_apparel = false
  assign swatch_accessory = false
  if swatch_type contains 'apparel'
    assign swatch_apparel = true
  endif
  if swatch_type contains 'accessories'
    assign swatch_accessory = true
  endif
  assign swatch_json = ''
  assign swatch_count = 0
  assign card_colors_json = '[]'

  if swatch_accessory or product_product.has_only_default_variant
    assign card_colors_json = '[]'
  elsif swatch_apparel
    assign swatch_opt_index = 0
    for option in product_product.options_with_values
      assign swatch_opt_name = option.name | downcase
      if swatch_opt_name contains 'color' or swatch_opt_name contains 'colour' or swatch_opt_name contains 'shade' or swatch_opt_name contains 'finish'
        assign swatch_opt_index = forloop.index
        break
      endif
    endfor
    if swatch_opt_index == 0
      assign swatch_first = product_product.options | first | downcase
      unless swatch_first contains 'size' or swatch_first contains 'title'
        assign swatch_opt_index = 1
      endunless
    endif
    if swatch_opt_index > 0
      for option in product_product.options_with_values
        if forloop.index == swatch_opt_index and option.values.size > 1
          for value in option.values
            assign swatch_label = value.name | default: value
            assign swatch_label_json = swatch_label | json
            assign swatch_hex = ''
            if value.swatch.color != blank
              assign swatch_hex = value.swatch.color | color_to_hex
            endif
            assign swatch_piece = '{"name":' | append: swatch_label_json
            if swatch_hex != blank
              assign swatch_hex_json = swatch_hex | json
              assign swatch_piece = swatch_piece | append: ',"hex":' | append: swatch_hex_json
            endif
            assign swatch_piece = swatch_piece | append: '}'
            if swatch_count > 0
              assign swatch_json = swatch_json | append: ','
            endif
            assign swatch_json = swatch_json | append: swatch_piece
            assign swatch_count = swatch_count | plus: 1
          endfor
        endif
      endfor
    endif
    if swatch_count > 1
      assign card_colors_json = '[' | append: swatch_json | append: ']'
    endif
  else
    assign swatch_seen = ''
    for variant in product_product.variants
      if variant.option1 and variant.title != 'Default Title'
        assign swatch_token = '|' | append: variant.option1 | downcase | append: '|'
        unless swatch_seen contains swatch_token
          assign swatch_seen = swatch_seen | append: swatch_token
          assign swatch_name_json = variant.option1 | json
          assign swatch_piece = '{"name":' | append: swatch_name_json | append: '}'
          if swatch_count > 0
            assign swatch_json = swatch_json | append: ','
          endif
          assign swatch_json = swatch_json | append: swatch_piece
          assign swatch_count = swatch_count | plus: 1
        endunless
      endif
    endfor
    if swatch_count > 1
      assign card_colors_json = '[' | append: swatch_json | append: ']'
    endif
  endif
  assign card_colors_json = card_colors_json | strip
-%}
{% assign is_priority_card = false %}
{% if card_priority %}
  {% assign is_priority_card = true %}
{% endif %}
{% if card_initial_image %}
  {% assign card_img_400 = card_initial_image | image_url: width: 400, format: 'webp' %}
{% endif %}


<div
  class='py-2 md:py-3 px-3 hover:cursor-pointer product-card w-full'
  data-product='{{ card_product_json | strip_newlines | escape }}'
  data-seed-variant='{{ card_seed_json | strip_newlines | escape }}'
  data-images='{{ card_images_json | strip_newlines | escape }}'
  data-card-colors='{{ card_colors_json | escape }}'
  {% if card_initial_image %}
    data-initial-image-id='{{ card_initial_image.id }}'
  {% endif %}
  @mouseenter='prefetchVariants()'
  @focusin='prefetchVariants()'
  x-data='
    productCard(
      {{ card_selected_variant.id }},
      {{ product_product.title | json }},
      {% if card_initial_image %}
        {{ card_img_400 | json }}
      {% else %}
        null
      {% endif %},
      {{ has_complex_tag | json }}
    )
  '
>
  <div class='bg-white overflow-hidden w-full flex flex-col transition-none'>
    <!-- Product Image -->
    <div class='relative h-[180px] md:h-[300px] lg:h-[300px] bg-white overflow-hidden'>
      <!-- Status / SOLD OUT Badge -->
      {% if kk_status != blank %}
        <div class='absolute top-2 left-2 md:top-4 md:left-4 bg-black text-white font-bold px-2 py-1 text-xs md:text-sm uppercase z-10'>
          {{ kk_status }}
        </div>
      {% else %}
        <div
          x-show='!isAvailable && !cardHasPreorder'
          class='absolute top-2 left-2 md:top-4 md:left-4 bg-black text-white font-bold px-2 py-1 text-xs md:text-sm uppercase z-10'
        >
          SOLD OUT
        </div>
      {% endif %}

      <!-- Product Image -->
      <a
        href='{{ product_product.url }}'
        @mouseenter='handleImageHover(true)'
        @mouseleave='handleImageHover(false)'
      >
        <!-- Base image: static WebP src for LCP; Alpine :src for variant/hover swaps.
             Do not set a static srcset here — browsers prefer srcset over :src and
             would keep showing the initial image after swatch clicks. -->
        <img
          width='400'
          height='400'
          {% if is_priority_card %}
            loading='eager'
            fetchpriority='high'
          {% else %}
            loading='lazy'
          {% endif %}
          decoding='async'
          {% if card_initial_image %}
            src='{{ card_img_400 }}'
          {% endif %}
          :src='currentImage'
          alt='{{ product_product.title | escape }}'
          :class="'absolute inset-0 w-full h-full {% if is_apparel %}object-contain object-top{% else %}object-contain{% endif %} transition-opacity duration-300 ' + ((isHovering && hoverImageLoaded) ? 'opacity-0' : 'opacity-100')"
        >
        <!-- Hover image (crossfades in) -->
        <img
          width='400'
          height='400'
          loading='lazy'
          decoding='async'
          x-cloak
          x-show='secondImageSrc'
          :src='secondImageSrc'
          alt='{{ product_product.title | escape }}'
          :class="'absolute inset-0 w-full h-full {% if is_apparel %}object-contain object-top{% else %}object-contain{% endif %} transition-opacity duration-300 pointer-events-none ' + ((isHovering && hoverImageLoaded) ? 'opacity-100' : 'opacity-0')"
        >
      </a>
    </div>

    <!-- Product Info -->
    <div class='p-4 md:p-6 flex flex-col {% if is_apparel %}gap-2{% else %}gap-3{% endif %} justify-between'>
      <div>
        <!-- Product Name -->
        <a href='{{ product_product.url }}'>
          <h2
            class='text-sm md:text-lg uppercase font-semibold text-gray-900 mb-2 text-center'
            x-text='baseTitle'
          >
            {{ product_product.title }}
          </h2>

          <!-- Price -->
          {% unless is_custom %}
            <div
              class='text-lg md:text-2xl font-bold text-gray-900 mb-1 text-center'
              x-text='formattedPrice'
            >
              {{ product_product.price | money }}
            </div>
          {% endunless %}
        </a>

        {%- unless card_colors_json == blank or card_colors_json == '[]' -%}
          <div
            class='mb-1'
            data-card-swatches
            data-swatch-mode='{% if is_apparel %}color{% else %}handle{% endif %}'
            role='group'
            aria-label='{% if is_apparel %}Color{% else %}Handle color{% endif %}'
          ></div>
        {%- endunless -%}
      </div>

      {% unless is_apparel or is_custom or is_accessory %}
        <!-- Add to Cart / Pre-order button -->
        <div x-show='canPurchase' x-cloak>
          <button
            @click='addToCart'
            :disabled='isAddingToCart'
            class='w-full bg-black cursor-pointer hover:bg-gray-900 text-white font-semibold py-2 md:py-3 px-3 md:px-4 text-xs md:text-base transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:ring-offset-2 disabled:opacity-50 disabled:cursor-not-allowed'
          >
            <span x-text="isAddingToCart ? 'Adding...' : cardAddToCartLabel"></span>
          </button>
        </div>
      {% endunless %}

      {% if is_apparel or is_accessory %}
        <!-- Quick View for Apparels -->
        <div>
          <button
            type='button'
            @click='openQuickView()'
            class='w-full bg-black text-white uppercase font-semibold py-2 md:py-3 px-3 md:px-4 text-xs md:text-base cursor-pointer hover:bg-gray-900 transition-colors duration-200'
          >
            Quick View
          </button>
        </div>
      {% endif %}
    </div>
  </div>
</div>
