{% comment %}
  Product Card
  This snippet is used to display a product card on the product page.
  It is used to display the product image, title, price, and add to cart button.
  It is also used to display the product variants and their images.
  It is also used to display the product images and their images.
  It is also used to display the product images and their images.
{% endcomment %}
{% assign product_tags_lower = product_product.tags | join: "||" | downcase %}
{% assign has_complex_tag = false %}
{% if product_tags_lower contains "use_complex_options" %}
  {% assign has_complex_tag = true %}
{% endif %}

{% assign product_type_lower = product_product.type | default: "" | downcase %}
{% assign is_apparel = false %}
{% assign is_accessory = false %}
{% assign is_custom = false %}
{% if product_type_lower contains "apparel" %}
  {% assign is_apparel = true %}
{% endif %}
{% if product_type_lower contains "accessories" %}
  {% assign is_accessory = true %}
{% endif %}
{% if product_type_lower contains "custom" %}
  {% assign is_custom = true %}
{% endif %}

{%- comment -%}
  Card hero: use product featured image only when it is not tied to an unavailable variant.
  If the featured image belongs to an OOS variant, use the first in-stock variant's image.
{%- endcomment -%}
{% assign card_initial_image = nil %}
{% if product_product.featured_image %}
  {% assign replace_featured_image = false %}
  {% for variant in product_product.variants %}
    {% if variant.featured_image
      and variant.featured_image.id == product_product.featured_image.id
    %}
      {% unless variant.available %}
        {% assign replace_featured_image = true %}
      {% endunless %}
      {% break %}
    {% endif %}
  {% endfor %}
  {% if replace_featured_image %}
    {% for variant in product_product.variants %}
      {% if variant.available and variant.featured_image %}
        {% assign card_initial_image = variant.featured_image %}
        {% break %}
      {% endif %}
    {% endfor %}
    {% if card_initial_image == blank and product_product.images.size > 0 %}
      {% assign card_initial_image = product_product.images[0] %}
    {% endif %}
  {% else %}
    {% assign card_initial_image = product_product.featured_image %}
  {% endif %}
{% elsif product_product.images.size > 0 %}
  {% assign card_initial_image = product_product.images[0] %}
{% endif %}

{%- comment -%} Lean card payloads + WebP (avoid full product/variant JSON + full-res CDN URLs) {%- endcomment -%}
{%- capture card_images_json -%}
[
{%- for image in product_product.images limit: 2 -%}
  {"id":{{ image.id | json }},"src":{{ image | image_url: width: 400, format: 'webp' | json }}}{%- unless forloop.last -%},{%- endunless -%}
{%- endfor -%}
]
{%- endcapture -%}
{%- capture card_product_json -%}
{"id":{{ product_product.id | json }},"title":{{ product_product.title | json }},"handle":{{ product_product.handle | json }},"type":{{ product_product.type | json }},"product_type":{{ product_product.type | json }},"available":{{ product_product.available | json }},"price":{{ product_product.price | json }},"options":{{ product_product.options | json }}}
{%- endcapture -%}
{%- capture card_variants_json -%}
[
{%- for variant in product_product.variants -%}
{"id":{{ variant.id | json }},"title":{{ variant.title | json }},"available":{{ variant.available | json }},"price":{{ variant.price | json }},"option1":{{ variant.option1 | json }},"option2":{{ variant.option2 | json }},"option3":{{ variant.option3 | json }}{% if variant.featured_image %},"featured_image":{"src":{{ variant.featured_image | image_url: width: 400, format: 'webp' | json }}}{% else %},"featured_image":null{% endif %}}{%- unless forloop.last -%},{%- endunless -%}
{%- endfor -%}
]
{%- endcapture -%}
{% assign is_priority_card = false %}
{% if card_priority %}
  {% assign is_priority_card = true %}
{% endif %}
{% if card_initial_image %}
  {% assign card_img_200 = card_initial_image | image_url: width: 200, format: 'webp' %}
  {% assign card_img_400 = card_initial_image | image_url: width: 400, format: 'webp' %}
{% endif %}

<div
  class='py-2 md:py-3 px-3 hover:cursor-pointer product-card w-full'
  data-product='{{ card_product_json | strip_newlines | escape }}'
  data-variants='{{ card_variants_json | strip_newlines | escape }}'
  data-images='{{ card_images_json | strip_newlines | escape }}'
  x-data='
    productCard(
      {{ product_product.selected_or_first_available_variant.id }},
      {{ product_product.title | json }},
      {% if card_initial_image %}
        {{ card_img_400 | json }}
      {% else %}
        null
      {% endif %},
      {{ has_complex_tag | json }}
    )
  '
>
  <div class='bg-white overflow-hidden w-full flex flex-col transition-none'>
    <!-- Product Image -->
    <div class='relative h-[180px] md:h-[300px] lg:h-[300px] bg-white overflow-hidden'>
      <!-- Status / SOLD OUT Badge -->
      {% assign kk_status = product_product.metafields.custom.product_status
        | default: product_product.metafields.custom_fields.product_status
        | default: product_product.metafields.global.product_status
      %}
      {% if kk_status != blank %}
        <div class='absolute top-2 left-2 md:top-4 md:left-4 bg-black text-white font-bold px-2 py-1 text-xs md:text-sm uppercase z-10'>
          {{ kk_status }}
        </div>
      {% else %}
        <div
          x-show='!isAvailable && !cardHasPreorder'
          class='absolute top-2 left-2 md:top-4 md:left-4 bg-black text-white font-bold px-2 py-1 text-xs md:text-sm uppercase z-10'
        >
          SOLD OUT
        </div>
      {% endif %}

      <!-- Product Image -->
      <a
        href='{{ product_product.url }}'
        @mouseenter='handleImageHover(true)'
        @mouseleave='handleImageHover(false)'
      >
        <!-- Base image: static WebP src for LCP; Alpine :src for variant/hover swaps -->
        <img
          width='400'
          height='400'
          {% if is_priority_card %}
            loading='eager'
            fetchpriority='high'
          {% else %}
            loading='lazy'
          {% endif %}
          decoding='async'
          {% if card_initial_image %}
            src='{{ card_img_400 }}'
            srcset='{{ card_img_200 }} 200w, {{ card_img_400 }} 400w'
            sizes='(min-width: 1100px) 33vw, 50vw'
          {% endif %}
          :src='currentImage'
          alt='{{ product_product.title | escape }}'
          :class="'absolute inset-0 w-full h-full {% if is_apparel %}object-contain object-top{% else %}object-contain{% endif %} transition-opacity duration-300 ' + ((isHovering && hoverImageLoaded) ? 'opacity-0' : 'opacity-100')"
        >
        <!-- Hover image (crossfades in) -->
        <img
          width='400'
          height='400'
          loading='lazy'
          decoding='async'
          x-cloak
          x-show='secondImageSrc'
          :src='secondImageSrc'
          alt='{{ product_product.title | escape }}'
          :class="'absolute inset-0 w-full h-full {% if is_apparel %}object-contain object-top{% else %}object-contain{% endif %} transition-opacity duration-300 pointer-events-none ' + ((isHovering && hoverImageLoaded) ? 'opacity-100' : 'opacity-0')"
        >
      </a>
    </div>

    <!-- Product Info -->
    <div class='p-4 md:p-6 flex flex-col {% if is_apparel %}gap-2{% else %}gap-3{% endif %} justify-between'>
      <div>
        <!-- Product Name -->
        <a href='{{ product_product.url }}'>
          <h2
            class='text-sm md:text-lg uppercase font-semibold text-gray-900 mb-2 text-center'
            x-text='baseTitle'
          >
            {{ product_product.title }}
          </h2>

          <!-- Price -->
          {% unless is_custom %}
            <div
              class='text-lg md:text-2xl font-bold text-gray-900 mb-1 text-center'
              x-text='formattedPrice'
            >
              {{ product_product.price | money }}
            </div>
          {% endunless %}
        </a>

        <!-- Handle Color Variants (hide for Apparels) -->
        {% unless product_product.has_only_default_variant
          or is_apparel
          or is_accessory
        %}
          {% assign handle_option_name = product_product.options
            | first
            | default: "Handle Color"
          %}
          <div class='mb-1'>
            <div class='flex flex-wrap gap-1 md:gap-2 justify-center'>
              {% assign unique_handle_colors = "" %}
              {% for variant in product_product.variants %}
                {% if variant.option1 and variant.title != "Default Title" %}
                  {% assign color_token = "|"
                    | append: variant.option1
                    | downcase
                    | append: "|"
                  %}
                  {% unless unique_handle_colors contains color_token %}
                    {% assign unique_handle_colors = unique_handle_colors
                      | append: color_token
                    %}
                    <button
                      @click='selectByHandle({{ variant.option1 | json }})'
                      :class="$el.dataset.handleLc && selectedOption1Lc === $el.dataset.handleLc ? 'ring-2 ring-black' : ''"
                      class='h-6 w-6 rounded-full border-2 border-gray-300 focus:outline-none focus:ring-2 focus:ring-black overflow-hidden'
                      title='{{ variant.option1 }}'
                      data-handle-lc='{{ variant.option1 | strip | downcase }}'
                    >
                      {% assign color_image = "" %}
                      {% assign option_lower = variant.option1 | downcase %}
                      {% assign cmp_option_token = handle_option_name
                        | strip
                        | downcase
                        | replace: " ", "_"
                        | replace: "-", "_"
                        | replace: "/", "_"
                        | replace: ".", "_"
                        | replace: "__", "_"
                        | replace: "__", "_"
                      %}
                      {% assign cmp_value_token = variant.option1
                        | strip
                        | downcase
                        | replace: " ", "_"
                        | replace: "-", "_"
                        | replace: "/", "_"
                        | replace: ".", "_"
                        | replace: "__", "_"
                        | replace: "__", "_"
                      %}
                      {% assign cmp_asset_filename = ""
                        | append: cmp_option_token
                        | append: "_"
                        | append: cmp_value_token
                        | append: ".png"
                      %}
                      {% assign cmp_asset_thumb = cmp_asset_filename
                        | asset_img_url: "64x64"
                      %}

                      {%- comment -%}
                        Priority for swatch image:
                        1) Variant featured_image
                        2) Local CMP asset (cmp_option_name_option_value.png)
                        3) Uploaded override in section settings (by color name)
                        4) Fallback asset color chip or plain colored circle
                      {%- endcomment -%}

                      {% if cmp_asset_thumb != blank %}
                        <img
                          width='48'
                          height='48'
                          src='{{ cmp_asset_thumb }}'
                          alt='{{ variant.option1 }}'
                          class='w-full h-full object-cover'
                        >
                      {% else %}
                        {%- comment -%} Settings-based overrides {%- endcomment -%}
                        {% if option_lower contains "black"
                          and option_lower contains "orange"
                        %}
                          {% if section.settings.black_orange_image %}
                            {% assign color_image = section.settings.black_orange_image
                              | image_url: width: 48
                            %}
                          {% else %}
                            {% assign color_image = "black_w_orange_liner.png" %}
                          {% endif %}
                        {% elsif option_lower contains "orange" %}
                          {% if section.settings.orange_image %}
                            {% assign color_image = section.settings.orange_image
                              | image_url: width: 48
                            %}
                          {% else %}
                            {% assign color_image = "orange.png" %}
                          {% endif %}
                        {% elsif option_lower contains "black" %}
                          {% if section.settings.black_image %}
                            {% assign color_image = section.settings.black_image
                              | image_url: width: 48
                            %}
                          {% else %}
                            {% assign color_image = "black_w_orange_liner.png" %}
                          {% endif %}
                        {% elsif option_lower contains "green" %}
                          {% if section.settings.green_image %}
                            {% assign color_image = section.settings.green_image
                              | image_url: width: 48
                            %}
                          {% else %}
                            {% assign color_image = "od_green.png" %}
                          {% endif %}
                        {% elsif option_lower contains "camo"
                          or option_lower contains "earth"
                        %}
                          {% if section.settings.camo_image %}
                            {% assign color_image = section.settings.camo_image
                              | image_url: width: 48
                            %}
                          {% else %}
                            {% assign color_image = "earth_camo.png" %}
                          {% endif %}
                        {% endif %}

                        {% if color_image != "" %}
                          {% if color_image contains "//" %}
                            <img
                              width='48'
                              height='48'
                              src='{{ color_image }}'
                              alt='{{ variant.option1 }}'
                              class='w-full h-full object-cover'
                            >
                          {% else %}
                            <img
                              width='48'
                              height='48'
                              src='{{ color_image | asset_url }}'
                              alt='{{ variant.option1 }}'
                              class='w-full h-full object-cover'
                            >
                          {% endif %}
                        {% else %}
                          <div
                            class='w-full h-full rounded-full'
                            style='background-color: {{ variant.option1 | downcase | replace: ' ', '' }}'
                          ></div>
                        {% endif %}
                      {% endif %}
                    </button>
                  {% endunless %}
                {% endif %}
              {% endfor %}
            </div>
          </div>
        {% endunless %}
      </div>

      {% unless is_apparel or is_custom or is_accessory %}
        <!-- Add to Cart / Pre-order button -->
        <div x-show='canPurchase' x-cloak>
          <button
            @click='addToCart'
            :disabled='isAddingToCart'
            class='w-full bg-black cursor-pointer hover:bg-gray-900 text-white font-semibold py-2 md:py-3 px-3 md:px-4 text-xs md:text-base transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:ring-offset-2 disabled:opacity-50 disabled:cursor-not-allowed'
          >
            <span x-text="isAddingToCart ? 'Adding...' : cardAddToCartLabel"></span>
          </button>
        </div>
      {% endunless %}

      {% if is_apparel or is_accessory %}
        <!-- Quick View for Apparels -->
        <div>
          <button
            type='button'
            @click='openQuickView()'
            class='w-full bg-black text-white uppercase font-semibold py-2 md:py-3 px-3 md:px-4 text-xs md:text-base cursor-pointer hover:bg-gray-900 transition-colors duration-200'
          >
            Quick View
          </button>
        </div>
      {% endif %}
    </div>
  </div>

  <!-- Quick View Drawer (Apparels, teleported to body) -->
  <template x-if='isQuickViewOpen'>
    <div class='fixed inset-0 z-50' x-cloak>
      <div class='absolute inset-0 bg-black/50' @click='closeQuickView()'></div>
      <div
        x-ref='qvPanel'
        class='absolute right-0 top-0 h-full w-full max-w-lg bg-white shadow-xl flex flex-col transform transition-transform duration-300 translate-x-full'
        x-init='requestAnimationFrame(() => $el.classList.remove("translate-x-full"))'
      >
        <div class='flex items-center justify-between p-5 border-b border-gray-200'>
          {% comment %} <h3 class='text-xl font-semibold' x-text='baseTitle'></h3> {% endcomment %}
          <h3 class='text-lg font-semibold'>Select options</h3>
          <button
            @click='closeQuickView()'
            class='text-gray-500 hover:text-gray-700 text-2xl leading-none'
          >
            ×
          </button>
        </div>
        <div class='p-6 flex-1 overflow-y-auto'>
          <div class='flex items-start space-x-6'>
            <img
              :src='qvImage || currentImage'
              alt=''
              width='160'
              height='160'
              class='w-40 h-40 object-contain'
            >
            <div class='min-w-0'>
              <p
                class='text-gray-900 uppercase text-lg truncate'
                x-text='baseTitle'
              ></p>
              <p class='text-base mt-2' x-text='qvFormattedPrice'></p>
            </div>
          </div>

          {% unless product_product.has_only_default_variant %}
            <template x-if='(optionNames && optionNames.length) || (variantsData && variantsData.length)'>
              <div>
                <!-- Option 1 -->
                <div class='mt-6' x-show='uniqueOptionValues(1).length'>
                  <p
                    class='text-xs font-semibold text-gray-700 mb-2 uppercase'
                    x-text='(optionNames[0] || "Option 1") + ":"'
                  ></p>
                  <div class='flex flex-wrap gap-3' x-show='isColorOption(1)'>
                    <template
                      x-for='val in uniqueOptionValues(1)'
                      :key='`c1-${val}`'
                    >
                      <button
                        @click='qvOption1 = val; updateQVSelectedVariant()'
                        :title='val'
                        :class="'w-12 h-12 rounded-md border overflow-hidden ' + (qvOption1 === val ? 'ring-2 ring-black' : '')"
                      >
                        <img
                          :src='imageForOptionValue(1,val)'
                          alt=''
                          width='48'
                          height='48'
                          class='w-full h-full object-contain'
                        >
                      </button>
                    </template>
                  </div>
                  <div class='flex flex-wrap gap-2' x-show='!isColorOption(1)'>
                    <template
                      x-for='val in uniqueOptionValues(1)'
                      :key='`t1-${val}`'
                    >
                      <button
                        @click='qvOption1 = val; updateQVSelectedVariant()'
                        :class="(qvOption1 === val ? 'ring-2 ring-black ' : '') + 'px-4 py-3 border rounded-md text-sm'"
                      >
                        <span x-text='val'></span>
                      </button>
                    </template>
                  </div>
                </div>

                <!-- Option 2 (if present) -->
                <div class='mt-6' x-show='uniqueOptionValues(2).length'>
                  <p
                    class='text-xs font-semibold text-gray-700 mb-2 uppercase'
                    x-text='(optionNames[1] || "Option 2") + ":"'
                  ></p>
                  <div class='flex flex-wrap gap-3' x-show='isColorOption(2)'>
                    <template
                      x-for='val in uniqueOptionValues(2)'
                      :key='`c2-${val}`'
                    >
                      <button
                        @click='qvOption2 = val; updateQVSelectedVariant()'
                        :disabled='!isComboAvailable(qvOption1, val)'
                        :title='val'
                        :class="'w-12 h-12 rounded-md border overflow-hidden ' + (qvOption2 === val ? 'ring-2 ring-black' : '') + (!isComboAvailable(qvOption1,val) ? ' opacity-40 cursor-not-allowed' : '')"
                      >
                        <img
                          :src='imageForOptionValue(2,val)'
                          alt=''
                          width='48'
                          height='48'
                          class='w-full h-full object-contain'
                        >
                      </button>
                    </template>
                  </div>
                  <div class='flex flex-wrap gap-2' x-show='!isColorOption(2)'>
                    <template
                      x-for='val in uniqueOptionValues(2)'
                      :key='`t2-${val}`'
                    >
                      <button
                        @click='qvOption2 = val; updateQVSelectedVariant()'
                        :disabled='!isComboAvailable(qvOption1, val)'
                        :class="((qvOption2 === val ? 'ring-2 ring-black ' : '') + 'px-4 py-3 border rounded-md text-sm ') + (!isComboAvailable(qvOption1, val) ? 'opacity-40 cursor-not-allowed' : '')"
                      >
                        <span x-text='val'></span>
                      </button>
                    </template>
                  </div>
                </div>
              </div>
            </template>
          {% endunless %}

          <div class='mt-8'>
            <p class='text-xs font-semibold text-gray-700 mb-2 uppercase'>
              Quantity
            </p>
            <div class='inline-flex items-center border'>
              <button
                class='w-10 h-10 text-lg'
                @click='qvQuantity = Math.max(1, (qvQuantity||1) - 1)'
              >
                −
              </button>
              <input
                type='number'
                min='1'
                x-model.number='qvQuantity'
                class='w-14 h-10 text-center outline-none border-none'
              >
              <button
                class='w-10 h-10 text-lg'
                @click='qvQuantity = (qvQuantity||1) + 1'
              >
                +
              </button>
            </div>
          </div>

          <!-- Primary action placed near options/quantity -->
          <div class='mt-6 space-y-3'>
            {% if kk_status != blank %}
              <button
                disabled
                class='w-full uppercase bg-gray-400 text-white font-bold py-4 text-base cursor-not-allowed'
              >
                {{ kk_status }}
              </button>
            {% else %}
              <button
                @click='qvAddToCart()'
                :disabled='!qvCanPurchase'
                class='w-full text-white font-bold py-4 text-base transition-colors duration-200'
                :class="qvCanPurchase ? 'cursor-pointer bg-black hover:bg-gray-900' : 'bg-gray-400 cursor-not-allowed opacity-80'"
              >
                <span x-text="qvAddToCartLabel"></span>
              </button>
            {% endif %}
            <a
              href='{{ product_product.url }}'
              class='block text-center underline text-gray-700 hover:text-gray-900'
              >View details</a
            >
          </div>
        </div>
      </div>
    </div>
  </template>
</div>


<!--
  Removed duplicate Quick View template (handled above within component scope)
-->
