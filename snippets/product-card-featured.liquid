{% comment %}
  Featured Collection Product Card (lean but full behavior)
  - Fixed-width image frame to avoid layout shifts
  - Title + formatted price
  - Image swatches (from variant.featured_image) that only swap the image
  - Knives (non-apparel/accessories): Add to Cart
  - Apparel/Accessories: Quick View drawer with options + Add to Cart
{% endcomment %}

{% assign product_obj = product_product %}
{% assign seed_type = product_obj.type | default: "" | downcase %}
{% assign seed_variant = nil %}
{% if seed_type contains "apparel" %}
  {% assign seed_variant = product_obj.variants.first %}
{% elsif seed_type contains "accessories" %}
  {% assign seed_variant = product_obj.selected_or_first_available_variant %}
{% else %}
  {% for variant in product_obj.variants %}
    {% if variant.available %}
      {% assign seed_variant = variant %}
      {% break %}
    {% endif %}
  {% endfor %}
  {% if seed_variant == nil %}
    {% assign seed_variant = product_obj.variants.first %}
  {% endif %}
{% endif %}
{% assign kk_status = product_obj.metafields.custom.product_status
  | default: product_obj.metafields.custom_fields.product_status
  | default: product_obj.metafields.global.product_status
%}

{%- capture card_images_json -%}
[
{%- for image in product_obj.images limit: 2 -%}
  {"id":{{ image.id | json }},"src":{{ image | image_url: width: 400, format: 'webp' | json }}}{%- unless forloop.last -%},{%- endunless -%}
{%- endfor -%}
]
{%- endcapture -%}
{%- capture card_product_json -%}
{"id":{{ product_obj.id | json }},"title":{{ product_obj.title | json }},"handle":{{ product_obj.handle | json }},"url":{{ product_obj.url | json }},"type":{{ product_obj.type | json }},"product_type":{{ product_obj.type | json }},"available":{{ product_obj.available | json }},"price":{{ product_obj.price | json }},"options":{{ product_obj.options | json }},"status":{{ kk_status | json }}}
{%- endcapture -%}
{%- capture card_seed_json -%}
{%- if seed_variant -%}
{"id":{{ seed_variant.id | json }},"title":{{ seed_variant.title | json }},"available":{{ seed_variant.available | json }},"price":{{ seed_variant.price | json }},"option1":{{ seed_variant.option1 | json }},"option2":{{ seed_variant.option2 | json }},"option3":{{ seed_variant.option3 | json }},"featured_image":null}
{%- else -%}
{}
{%- endif -%}
{%- endcapture -%}
{%- capture card_colors_json -%}{%- render 'product-card-colors', product_product: product_obj -%}{%- endcapture -%}
{%- assign card_colors_json = card_colors_json | strip -%}

<div
  class='product-card w-full box-border py-4 px-2 sm:py-6 sm:px-3'
  data-product='{{ card_product_json | strip_newlines | escape }}'
  data-seed-variant='{{ card_seed_json | strip_newlines | escape }}'
  data-images='{{ card_images_json | strip_newlines | escape }}'
  data-card-colors='{{ card_colors_json | escape }}'
  {% if product_obj.featured_image %}
    data-initial-image-id='{{ product_obj.featured_image.id }}'
  {% endif %}
  @mouseenter='prefetchVariants()'
  @focusin='prefetchVariants()'
  x-data='fcCard()'
>
  <div class='bg-white overflow-hidden w-full flex flex-col'>
    <!-- Image well -->
    <div class='relative h-[180px] md:h-[300px] lg:h-[300px] bg-white overflow-hidden flex items-center justify-center'>
      {% if kk_status != blank %}
        <div class='absolute top-4 left-4 bg-black text-white font-bold px-3 py-1 text-sm uppercase z-10'>
          {{ kk_status }}
        </div>
      {% else %}
        <div
          x-show='!isAvailable && !cardHasPreorder'
          class='absolute top-4 left-4 bg-black text-white font-bold px-3 py-1 text-sm uppercase z-10'
        >
          SOLD OUT
        </div>
      {% endif %}

      <!-- fixed-width inner box so images never stretch the grid -->
      {% assign product_type_lower = product_obj.type
        | default: ""
        | downcase
      %}
      {% assign image_wrapper_classes = "relative h-full w-full mx-auto block" %}
      {% assign card_display_image = product_obj.featured_image
        | default: product_obj.images.first
      %}
      {% if product_type_lower contains "apparel" %}
        {% assign apparel_first_variant = product_obj.variants.first %}
        {% if apparel_first_variant.featured_image %}
          {% assign card_display_image = apparel_first_variant.featured_image %}
        {% endif %}
      {% elsif seed_variant.featured_image %}
        {% unless product_type_lower contains "accessories" %}
          {% assign card_display_image = seed_variant.featured_image %}
        {% endunless %}
      {% endif %}
      {% if product_type_lower contains "apparel"
        or product_type_lower contains "hoodie"
        or product_type_lower contains "sweatshirt"
      %}
        {% assign image_wrapper_classes = image_wrapper_classes
          | append: " max-w-[280px] sm:max-w-[320px] md:max-w-[360px]"
        %}
      {% else %}
        {% assign image_wrapper_classes = image_wrapper_classes
          | append: " max-w-[240px] sm:max-w-[280px] md:max-w-[320px]"
        %}
      {% endif %}
      <a
        href='{{ product_obj.url }}'
        class='{{ image_wrapper_classes }}'
        @mouseenter='handleImageHover(true)'
        @mouseleave='handleImageHover(false)'
      >
        <!-- Base image -->
        <img
          width='400'
          height='400'
          loading='lazy'
          decoding='async'
          src='{{ card_display_image | image_url: width: 400, format: 'webp' }}'
          :src='currentImage'
          alt='{{ product_obj.title | escape }}'
          :class="'absolute inset-0 w-full h-full object-contain transition-opacity duration-300 ' + ((isHovering && hoverImageLoaded) ? 'opacity-0' : 'opacity-100')"
        >
        <!-- Hover image (crossfades in) -->
        <img
          width='400'
          height='400'
          x-cloak
          x-show='secondImageSrc'
          :src='secondImageSrc'
          alt='{{ product_obj.title | escape }}'
          :class="'absolute inset-0 w-full h-full object-contain transition-opacity duration-300 pointer-events-none ' + ((isHovering && hoverImageLoaded) ? 'opacity-100' : 'opacity-0')"
          loading='lazy'
          decoding='async'
        >
      </a>
    </div>

    <!-- Info -->
    <div class='p-4 md:p-6 flex flex-col justify-between'>
      <div>
        <a href='{{ product_obj.url }}'>
          <h2
            class='text-sm md:text-lg uppercase font-semibold text-gray-900 mb-2 text-center whitespace-normal break-words'
            x-text='baseTitle'
          >
            {{ product_obj.title }}
          </h2>
          {% assign product_type_lower = product_obj.type
            | default: ""
            | downcase
          %}
          {% unless product_type_lower contains "custom" %}
            <div
              class='text-lg md:text-2xl font-bold text-gray-900 mb-4 text-center'
              x-text='formattedPrice'
            >
              {{ product_obj.price | money }}
            </div>
          {% endunless %}
        </a>

        {%- assign type_lower = product_obj.type | default: "" | downcase -%}
        {%- unless card_colors_json == blank or card_colors_json == '[]' -%}
          <div
            class='mb-2'
            data-card-swatches
            data-swatch-mode='{% if type_lower contains "apparel" %}color{% else %}handle{% endif %}'
            role='group'
            aria-label='{% if type_lower contains "apparel" %}Color{% else %}Handle color{% endif %}'
          ></div>
        {%- endunless -%}
      </div>
    </div>

    {% assign type_lower = product_obj.type | default: "" | downcase %}
    {% unless type_lower contains "apparel"
      or type_lower contains "accessories"
    %}
      <!-- Add to Cart for knives/non-apparel -->
      <div class='px-4'>
        <div x-show='canPurchase' x-cloak>
        <button
          @click='addToCart'
          :disabled='isAddingToCart'
          class='w-full bg-black hover:bg-gray-900 text-white font-semibold py-2 md:py-3 px-3 md:px-4 text-xs md:text-base transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:ring-offset-2 disabled:opacity-50 disabled:cursor-not-allowed'
        >
          <span x-text="isAddingToCart ? 'Adding...' : cardAddToCartLabel"></span>
        </button>
        </div>
      </div>
    {% else %}
      <!-- Quick View button for apparel/accessories -->
      <div class='px-4'>
        <button
          type='button'
          @click='openQuickView()'
          class='w-full bg-black text-white uppercase font-semibold py-2 md:py-3 px-3 md:px-4 text-xs md:text-base hover:bg-gray-900'
        >
          Quick View
        </button>
      </div>
    {% endunless %}

  </div>
</div>
