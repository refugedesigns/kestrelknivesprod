{% liquid
  assign media_alt = media.alt | strip
  if media_alt == blank
    assign media_alt = media.preview_image.alt | strip
  endif
  if media_alt == blank and product.title != blank
    assign media_alt = product.title
  endif
%}
{% case media.media_type %}
  {% when "image" %}
    <img
      src='{{ media | img_url: 'large' }}'
      alt='{{ media_alt | escape }}'
      class='w-full h-full object-contain'
    >

  {% when "external_video" %}
    {{ media | external_video_tag: class: "w-full h-80 object-cover" }}

  {% when "video" %}
    {{ media | video_tag: controls: true, class: "w-full h-full object-cover" }}

  {% when "model" %}
    {{ media | model_viewer_tag }}

  {% else %}
    {{ media | media_tag }}
{% endcase %}
