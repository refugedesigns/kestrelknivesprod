{% comment %}
  Store-wide return and shipping policies for Google merchant listings.
  Source: the live Refund policy, the Shipping policy, /pages/shipping-returns
  and the Shopify shipping rates (2026-10-20), plus James's answers
  (2026-10-20): international orders use the same return policy, and
  handling time is 1-2 business days. If the policy or rates change, change
  this file too.

  part (passed by the caller):
    blank         -> Organization properties, starting with a comma
                     (layout/theme.liquid)
    'offer-refs'  -> the offer's hasMerchantReturnPolicy value: @id refs to
                     the store policies (snippets/product-json-ld.liquid)
    'final-sale'  -> the offer's hasMerchantReturnPolicy value for final-sale
                     items: returns not permitted

  Google allows up to 50 countries per return policy, so the countries are
  split into groups of 50 with one identical policy per group. The country
  list is Shopify's shipsToCountries minus the shipping policy's "we do not
  ship to" list (and the non-ISO codes AC, TA, XK). US comes first.
  Returns always go back to the US (Edinboro, PA).
{% endcomment %}
{%- liquid
  assign country_groups = 'US,AD,AF,AG,AI,AL,AM,AO,AT,AU,AW,AX,AZ,BA,BB,BE,BF,BG,BH,BI,BJ,BL,BM,BN,BO,BQ,BS,BT,BW,BZ,CA,CC,CD,CF,CG,CH,CI,CK,CL,CM,CR,CV,CW,CX,CY,CZ,DE,DJ,DM,DO|EC,EE,EH,ER,ES,ET,FI,FJ,FK,FO,FR,GA,GB,GD,GE,GF,GG,GI,GL,GM,GN,GP,GQ,GR,GS,GT,GW,GY,HK,HN,HR,HT,HU,IL,IM,IO,IQ,IS,IT,JE,JM,JO,JP,KG,KH,KI,KM,KN,KR,KW|KY,KZ,LA,LB,LC,LI,LK,LR,LS,LT,LU,LV,LY,MC,MD,ME,MF,MG,MK,ML,MM,MN,MO,MQ,MR,MS,MT,MU,MV,MW,MX,MZ,NA,NC,NE,NF,NI,NL,NO,NP,NR,NU,NZ,OM,PA,PE,PF,PG,PL,PM|PN,PS,PT,PY,RE,RO,RS,RW,SB,SC,SE,SH,SI,SJ,SK,SL,SM,SN,SO,SR,SS,ST,SV,SX,SZ,TC,TD,TF,TG,TH,TJ,TK,TL,TM,TN,TO,TT,TV,TW,TZ,UA,UG,UM,UY,UZ,VA,VC,VE,VG,VN|VU,WF,WS,YE,YT,ZA,ZM,ZW' | split: '|'
  assign policy_page_url = shop.url | append: '/pages/shipping-returns'
  # Highest cost we state for standard ground (Lower 48 + DC). Paid rates are
  # carrier-calculated USPS/UPS quotes plus a $3 fee, so this is an upper
  # bound, not a quote.
  assign standard_ground_max_rate = '15.00'
-%}
{%- case part -%}
{%- when 'offer-refs' -%}
[
  {%- for group in country_groups -%}
    { "@id": {{ policy_page_url | append: '#return-policy-' | append: forloop.index | json }} }{%- unless forloop.last -%},{%- endunless -%}
  {%- endfor -%}
]
{%- when 'final-sale' -%}
[
  {%- for group in country_groups -%}
    {
      "@type": "MerchantReturnPolicy",
      "applicableCountry": {{ group | split: ',' | json }},
      "returnPolicyCategory": "https://schema.org/MerchantReturnNotPermitted"
    }{%- unless forloop.last -%},{%- endunless -%}
  {%- endfor -%}
]
{%- else -%}
,"hasMerchantReturnPolicy": [
  {%- for group in country_groups -%}
  {
    "@type": "MerchantReturnPolicy",
    "@id": {{ policy_page_url | append: '#return-policy-' | append: forloop.index | json }},
    "merchantReturnLink": {{ policy_page_url | json }},
    "applicableCountry": {{ group | split: ',' | json }},
    "returnPolicyCountry": "US",
    "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
    "merchantReturnDays": 5,
    "returnMethod": "https://schema.org/ReturnByMail",
    "itemCondition": "https://schema.org/NewCondition",
    "returnFees": "https://schema.org/ReturnFeesCustomerResponsibility",
    "customerRemorseReturnFees": "https://schema.org/ReturnFeesCustomerResponsibility",
    "returnLabelSource": "https://schema.org/ReturnLabelCustomerResponsibility",
    "itemDefectReturnFees": "https://schema.org/FreeReturn",
    "restockingFee": 15
  }{%- unless forloop.last -%},{%- endunless -%}
  {%- endfor -%}
]
,"hasShippingService": {
  "@type": "ShippingService",
  "@id": {{ policy_page_url | append: '#shipping-policy' | json }},
  "name": "Standard ground shipping (US Lower 48 + DC)",
  "description": "Lower 48 states and DC: carrier-calculated USPS or UPS standard ground rates shown at checkout, up to $15.00. Ships in 1–2 business days; ground transit 3–7 business days. Alaska, Hawaii, U.S. territories and international orders pay the rates shown at checkout or quoted by email.",
  "fulfillmentType": "https://schema.org/FulfillmentTypeDelivery",
  "handlingTime": {
    "@type": "ServicePeriod",
    "businessDays": ["https://schema.org/Monday","https://schema.org/Tuesday","https://schema.org/Wednesday","https://schema.org/Thursday","https://schema.org/Friday"],
    "duration": {
      "@type": "QuantitativeValue",
      "minValue": 1,
      "maxValue": 2,
      "unitCode": "DAY"
    }
  },
  "shippingConditions": [
    {
      "@type": "ShippingConditions",
      "shippingDestination": {
        "@type": "DefinedRegion",
        "addressCountry": "US",
        "addressRegion": ["AL","AZ","AR","CA","CO","CT","DE","DC","FL","GA","ID","IL","IN","IA","KS","KY","LA","ME","MD","MA","MI","MN","MS","MO","MT","NE","NV","NH","NJ","NM","NY","NC","ND","OH","OK","OR","PA","RI","SC","SD","TN","TX","UT","VT","VA","WA","WV","WI","WY"]
      },
      "shippingRate": {
        "@type": "MonetaryAmount",
        "maxValue": {{ standard_ground_max_rate }},
        "currency": "USD"
      },
      "transitTime": {
        "@type": "ServicePeriod",
        "businessDays": ["https://schema.org/Monday","https://schema.org/Tuesday","https://schema.org/Wednesday","https://schema.org/Thursday","https://schema.org/Friday"],
        "duration": {
          "@type": "QuantitativeValue",
          "minValue": 3,
          "maxValue": 7,
          "unitCode": "DAY"
        }
      }
    }
  ]
}
{%- endcase -%}
