<!-- Collection Filters -->
<div
  class='hidden md:block w-full md:w-1/4 lg:w-1/5 mb-8 md:mb-0'
  x-data='collectionFilters()'
>
  <div class='bg-white border border-gray-200 rounded-lg p-6'>
    <h3 class='text-lg font-bold text-gray-900 mb-6'>Filters</h3>

    <!-- Product Type Filter -->
    <div class='mb-6'>
      <button
        @click='toggleFilter("productType")'
        class='flex items-center justify-between w-full text-left font-semibold text-gray-900 mb-3'
      >
        <span>Product Type</span>
        <svg
          class='w-4 h-4 transition-transform duration-200'
          :class="filtersOpen.productType ? 'rotate-180' : ''"
          fill='none'
          stroke='currentColor'
          viewBox='0 0 24 24'
        >
          <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M19 9l-7 7-7-7'/>
        </svg>
      </button>

      <div x-show='filtersOpen.productType' class='space-y-2'>
        <template x-for='t in productTypes' :key='t.value'>
          <div>
            <label class='flex items-center space-x-2 cursor-pointer'>
              <input
                type='radio'
                name='productType'
                :value='t.value'
                x-model='selectedFilters.productTypeSelected'
                @change='onParentTypeChange()'
                class='border-gray-300 text-black focus:ring-gray-900'
              >
              <span
                class='text-sm text-gray-700'
                x-text='titleCase(t.value)'
              ></span>
            </label>

            <!-- Group-tag subfilters under the selected parent -->
            <template
              x-if='isParentSelected(t.value) && groupTags.length'
            >
              <div class='mt-2 space-y-2 pl-6'>
                <template x-for='tag in groupTags' :key='tag.tag'>
                  <label class='flex items-center space-x-2 cursor-pointer'>
                    <input
                      type='checkbox'
                      :checked='isGroupTagSelected(tag)'
                      @change='toggleGroupTag(tag.tag, $event.target.checked)'
                      class='border-gray-300 text-black focus:ring-gray-900'
                    >
                    <span
                      class='text-sm text-gray-700'
                      x-text='tag.label'
                    ></span>
                  </label>
                </template>
              </div>
            </template>
          </div>
        </template>
      </div>
    </div>

    <!-- Availability Filter -->
    <div class='mb-6'>
      <button
        @click='toggleFilter("availability")'
        class='flex items-center justify-between w-full text-left font-semibold text-gray-900 mb-3'
      >
        <span>Availability</span>
        <svg
          class='w-4 h-4 transition-transform duration-200'
          :class="filtersOpen.availability ? 'rotate-180' : ''"
          fill='none'
          stroke='currentColor'
          viewBox='0 0 24 24'
        >
          <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M19 9l-7 7-7-7'/>
        </svg>
      </button>

      <div x-show='filtersOpen.availability' class='space-y-2'>
        <label class='flex items-center space-x-2 cursor-pointer'>
          <input
            type='radio'
            name='availability'
            value=''
            x-model='selectedFilters.availabilitySelected'
            @change='applyFilters()'
            class='border-gray-300 text-black focus:ring-gray-900'
          >
          <span class='text-sm text-gray-700'>All</span>
        </label>
        <label class='flex items-center space-x-2 cursor-pointer'>
          <input
            type='radio'
            name='availability'
            value='in-stock'
            x-model='selectedFilters.availabilitySelected'
            @change='applyFilters()'
            class='border-gray-300 text-black focus:ring-gray-900'
          >
          <span class='text-sm text-gray-700'
            >In Stock (<span x-text='inStockCount'></span>)</span
          >
        </label>
        <label class='flex items-center space-x-2 cursor-pointer'>
          <input
            type='radio'
            name='availability'
            value='out-of-stock'
            x-model='selectedFilters.availabilitySelected'
            @change='applyFilters()'
            class='border-gray-300 text-black focus:ring-gray-900'
          >
          <span class='text-sm text-gray-700'
            >Out Of Stock (<span x-text='outOfStockCount'></span>)</span
          >
        </label>
      </div>
    </div>

    <button
      @click='clearFilters'
      class='w-full bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium py-2 px-4 rounded transition-colors duration-200'
    >
      Clear Filters
    </button>
  </div>
</div>

<script>
  window.__filterMeta = window.__filterMeta || {}
  window.__filterMeta.productTypes = [
    {% assign pt = collection.filters | where: 'param_name', 'filter.p.product_type' | first %}
    {% if pt and pt.values %}
      {% for v in pt.values %}
        { value: {{ v.value | json }}, count: {{ v.count | default: 0 }} }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    {% endif %}
  ]
  window.__filterMeta.availability = {
    {% assign av = collection.filters | where: 'param_name', 'filter.v.availability' | first %}
    {% if av and av.values %}
      {% for v in av.values %}
        {% if v.value == '1' or v.value == true %}
          in: {{ v.count | default: 0 }},
        {% elsif v.value == '0' or v.value == false %}
          out: {{ v.count | default: 0 }},
        {% endif %}
      {% endfor %}
    {% endif %}
  }
</script>
<script>
  document.addEventListener('alpine:init', () => {
    Alpine.data('collectionFilters', () => ({
      // Fixed parent filters only
      PARENT_TYPES: ['Accessories', 'Apparel', 'Ultralight Knives'],

      filtersOpen: {
        productType: true,
        availability: true,
      },
      selectedFilters: {
        productTypeSelected: '',
        groupTagSelected: '',
        availabilitySelected: '',
      },
      productTypes: [],
      groupTags: [],
      isInitializing: true,

      titleCase(str) {
        try {
          return String(str || '')
            .toLowerCase()
            .split(/\s+/)
            .map(w => w.charAt(0).toUpperCase() + w.slice(1))
            .join(' ')
        } catch (e) {
          return str
        }
      },

      toHandleSafe(val) {
        try {
          return String(val || '')
            .toLowerCase()
            .trim()
            .replace(/[^a-z0-9]+/g, '-')
            .replace(/^-+|-+$/g, '')
        } catch (e) {
          return ''
        }
      },

      normalizeType(val) {
        return String(val || '')
          .toLowerCase()
          .trim()
          .replace(/[_-]+/g, ' ')
          .replace(/\s+/g, ' ')
      },

      matchesParentType(productType, parentValue) {
        const a = this.normalizeType(productType)
        const b = this.normalizeType(parentValue)
        if (!a || !b) return false
        if (a === b) return true
        if (this.toHandleSafe(a) === this.toHandleSafe(b)) return true
        return false
      },

      isParentSelected(typeValue) {
        return this.matchesParentType(
          this.selectedFilters.productTypeSelected,
          typeValue
        )
      },

      isGroupTagSelected(tag) {
        const sel = this.selectedFilters.groupTagSelected
        if (!sel || !tag) return false
        if (sel === tag.tag) return true
        return this.toHandleSafe(sel) === tag.handle
      },

      isAllowedParent(val) {
        const n = this.normalizeType(val)
        return this.PARENT_TYPES.some(p => this.normalizeType(p) === n)
      },

      /**
       * Tags whose last word is "Group" → { tag, label without Group, handle }
       * e.g. "Hat Group" → label "Hat"
       */
      parseGroupTag(raw) {
        const s = String(raw || '').trim()
        if (!s) return null
        const parts = s.split(/\s+/).filter(Boolean)
        if (parts.length < 2) return null
        if (parts[parts.length - 1].toLowerCase() !== 'group') return null
        const labelParts = parts.slice(0, -1)
        const label = this.titleCase(labelParts.join(' '))
        if (!label) return null
        return {
          tag: s,
          label,
          handle: this.toHandleSafe(s),
        }
      },

      async init() {
        sessionStorage.removeItem('kk_allProductTypes')
        sessionStorage.removeItem('kk_apparelTagsAll')

        this.buildProductTypes()
        this.hydrateFromUrl()
        this.buildGroupTags()

        this.isInitializing = false
      },

      buildProductTypes() {
        try {
          const meta = (window.__filterMeta && window.__filterMeta.productTypes) || []
          const products = window.__collectionProducts || []

          this.productTypes = this.PARENT_TYPES.map(canonical => {
            const metaHit = meta.find(t =>
              this.matchesParentType(t.value, canonical)
            )
            // Prefer Shopify's exact type string when present
            const value = metaHit ? String(metaHit.value) : canonical
            let count = metaHit ? Number(metaHit.count || 0) : 0
            if (!count && products.length) {
              count = products.filter(p =>
                this.matchesParentType(p.product_type || p.type, canonical)
              ).length
            }
            return { value, count }
          })
        } catch (e) {
          this.productTypes = this.PARENT_TYPES.map(value => ({
            value,
            count: 0,
          }))
        }
      },

      buildGroupTags() {
        try {
          const selected = this.selectedFilters.productTypeSelected
          if (!selected || !this.isAllowedParent(selected)) {
            this.groupTags = []
            return
          }

          const map = {}
          ;(window.__collectionProducts || []).forEach(p => {
            if (!this.matchesParentType(p.product_type || p.type, selected)) {
              return
            }
            ;(p.tags || []).forEach(tag => {
              const parsed = this.parseGroupTag(tag)
              if (!parsed) return
              if (!map[parsed.tag]) map[parsed.tag] = parsed
            })
          })

          this.groupTags = Object.values(map).sort((a, b) =>
            String(a.label).localeCompare(String(b.label))
          )

          // Keep the active URL tag visible even if not in the current product dump
          const active = this.selectedFilters.groupTagSelected
          if (active) {
            const parsed = this.parseGroupTag(active)
            const exists = this.groupTags.some(
              t =>
                t.tag === active ||
                t.handle === this.toHandleSafe(active) ||
                (parsed && t.tag === parsed.tag)
            )
            if (!exists) {
              const fallback =
                parsed ||
                ({
                  tag: active,
                  label: this.titleCase(
                    String(active).replace(/\s+group$/i, '').trim()
                  ),
                  handle: this.toHandleSafe(active),
                })
              this.groupTags.push(fallback)
              this.groupTags.sort((a, b) =>
                String(a.label).localeCompare(String(b.label))
              )
            }
          }
        } catch (e) {
          this.groupTags = []
        }
      },

      hydrateFromUrl() {
        try {
          const url = new URL(window.location.href)

          const types = (url.searchParams.getAll('filter.p.product_type') || [])
            .filter(t => this.isAllowedParent(t))

          if (types.length) {
            // Map URL value onto the allowlisted productTypes entry
            const match = (this.productTypes || []).find(pt =>
              this.matchesParentType(pt.value, types[0])
            )
            this.selectedFilters.productTypeSelected = match
              ? match.value
              : types[0]
          } else {
            // Infer parent from collection handle when it matches an allowlisted type
            const path = window.location.pathname || ''
            const m = path.match(/\/collections\/([^\/]+)/)
            const collectionHandle = m && m[1] ? decodeURIComponent(m[1]) : ''

            if (collectionHandle && collectionHandle !== 'all') {
              const matchType = (this.productTypes || []).find(pt => {
                const typeHandle = this.toHandleSafe(pt.value)
                if (typeHandle === collectionHandle) return true
                if (typeHandle.endsWith('-' + collectionHandle)) return true
                if (
                  collectionHandle.endsWith('s') &&
                  typeHandle === collectionHandle.slice(0, -1)
                )
                  return true
                return false
              })
              if (matchType) {
                this.selectedFilters.productTypeSelected = matchType.value
              }
            }
          }

          const avParam = url.searchParams.get('filter.v.availability')
          if (avParam !== null) {
            if (String(avParam) === '1') {
              this.selectedFilters.availabilitySelected = 'in-stock'
            } else if (String(avParam) === '0') {
              this.selectedFilters.availabilitySelected = 'out-of-stock'
            }
          }

          // Group tag from query (exact tag value, e.g. "Hat Group")
          const tagParam = url.searchParams.get('filter.p.tag')
          if (tagParam) {
            this.selectedFilters.groupTagSelected = tagParam
          }
        } catch (e) {
          // ignore
        }
      },

      onParentTypeChange() {
        this.selectedFilters.groupTagSelected = ''
        this.selectedFilters.availabilitySelected = ''
        this.buildGroupTags()
        this.applyFilters(true)
      },

      toggleGroupTag(tag, checked) {
        this.selectedFilters.groupTagSelected = checked ? tag : ''
        this.applyFilters()
      },

      toggleFilter(filterName) {
        this.filtersOpen[filterName] = !this.filtersOpen[filterName]
      },

      clearFilters() {
        this.selectedFilters = {
          productTypeSelected: '',
          groupTagSelected: '',
          availabilitySelected: '',
        }
        this.groupTags = []
        this.applyFilters()
      },

      get inStockCount() {
        const meta = window.__filterMeta || {}
        if (meta.availability && typeof meta.availability.in === 'number') {
          return meta.availability.in
        }
        const products = window.__collectionProducts || []
        return products.filter(p => p.available).length
      },

      get outOfStockCount() {
        const meta = window.__filterMeta || {}
        if (meta.availability && typeof meta.availability.out === 'number') {
          return meta.availability.out
        }
        const products = window.__collectionProducts || []
        return products.filter(p => !p.available).length
      },

      applyFilters(productTypeChanged = false) {
        if (this.isInitializing) return

        if (productTypeChanged) {
          this.selectedFilters.availabilitySelected = ''
          this.selectedFilters.groupTagSelected = ''
        }

        const url = new URL(window.location.href)
        url.searchParams.delete('page')

        // Stay on the current collection; only normalize legacy /collections/all/{tag} paths
        const path = url.pathname || ''
        if (/\/collections\/all\/[^/]+$/.test(path)) {
          url.pathname = '/collections/all'
        }

        // Parent product type
        url.searchParams.delete('filter.p.product_type')
        const selected = this.selectedFilters.productTypeSelected || ''
        if (selected && this.isAllowedParent(selected)) {
          url.searchParams.append('filter.p.product_type', selected)
        }

        // Group subfilter → Shopify product tag filter (exact tag, includes "Group")
        url.searchParams.delete('filter.p.tag')
        const groupTag = this.selectedFilters.groupTagSelected || ''
        if (groupTag) {
          url.searchParams.append('filter.p.tag', groupTag)
        }

        // Availability
        url.searchParams.delete('filter.v.availability')
        const availabilitySelected =
          this.selectedFilters.availabilitySelected || ''
        if (availabilitySelected === 'in-stock') {
          url.searchParams.append('filter.v.availability', '1')
        } else if (availabilitySelected === 'out-of-stock') {
          url.searchParams.append('filter.v.availability', '0')
        }

        const nextUrl = url.toString()
        if (nextUrl === window.location.href) return
        window.location.href = nextUrl
      },
    }))
  })
</script>
