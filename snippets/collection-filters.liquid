<!-- Collection Filters -->
<div
  class='hidden md:block w-full md:w-1/4 lg:w-1/5 mb-8 md:mb-0'
  x-data='collectionFilters()'
>
  <div class='bg-white border border-gray-200 rounded-lg p-6'>
    <h3 class='text-lg font-bold text-gray-900 mb-6'>Filters</h3>

    <!-- Product Type Filter -->
    <div class='mb-6'>
      <button
        @click='toggleFilter("productType")'
        class='flex items-center justify-between w-full text-left font-semibold text-gray-900 mb-3'
      >
        <span>Product Type</span>
        <svg
          class='w-4 h-4 transition-transform duration-200'
          :class="filtersOpen.productType ? 'rotate-180' : ''"
          fill='none'
          stroke='currentColor'
          viewBox='0 0 24 24'
        >
          <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M19 9l-7 7-7-7'/>
        </svg>
      </button>

      <div x-show='filtersOpen.productType' class='space-y-2'>
        <template x-for='t in productTypes' :key='t.value'>
          <div>
            <label class='flex items-center space-x-2 cursor-pointer'>
              <input
                type='radio'
                name='productType'
                :value='t.value'
                x-model='selectedFilters.productTypeSelected'
                @change='onParentTypeChange()'
                class='border-gray-300 text-black focus:ring-gray-900'
              >
              <span
                class='text-sm text-gray-700'
                x-text='titleCase(t.value)'
              ></span>
            </label>

            <!-- Group-tag subfilters under the selected parent -->
            <div
              class='mt-2 space-y-2 pl-6'
              x-show='isParentSelected(t.value) && groupTags.length'
            >
              <template x-for='tag in groupTags' :key='tag.tag'>
                <label class='flex items-center space-x-2 cursor-pointer'>
                  <input
                    type='checkbox'
                    :checked='isGroupTagSelected(tag)'
                    @change='toggleGroupTag(tag.tag, $event.target.checked)'
                    class='border-gray-300 text-black focus:ring-gray-900'
                  >
                  <span
                    class='text-sm text-gray-700'
                    x-text='tag.label'
                  ></span>
                </label>
              </template>
            </div>
          </div>
        </template>
      </div>
    </div>

    <!-- Availability Filter -->
    <div class='mb-6'>
      <button
        @click='toggleFilter("availability")'
        class='flex items-center justify-between w-full text-left font-semibold text-gray-900 mb-3'
      >
        <span>Availability</span>
        <svg
          class='w-4 h-4 transition-transform duration-200'
          :class="filtersOpen.availability ? 'rotate-180' : ''"
          fill='none'
          stroke='currentColor'
          viewBox='0 0 24 24'
        >
          <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M19 9l-7 7-7-7'/>
        </svg>
      </button>

      <div x-show='filtersOpen.availability' class='space-y-2'>
        <label class='flex items-center space-x-2 cursor-pointer'>
          <input
            type='radio'
            name='availability'
            value=''
            x-model='selectedFilters.availabilitySelected'
            @change='applyFilters()'
            class='border-gray-300 text-black focus:ring-gray-900'
          >
          <span class='text-sm text-gray-700'>All</span>
        </label>
        <label class='flex items-center space-x-2 cursor-pointer'>
          <input
            type='radio'
            name='availability'
            value='in-stock'
            x-model='selectedFilters.availabilitySelected'
            @change='applyFilters()'
            class='border-gray-300 text-black focus:ring-gray-900'
          >
          <span class='text-sm text-gray-700'
            >In Stock (<span x-text='inStockCount'></span>)</span
          >
        </label>
        <label class='flex items-center space-x-2 cursor-pointer'>
          <input
            type='radio'
            name='availability'
            value='out-of-stock'
            x-model='selectedFilters.availabilitySelected'
            @change='applyFilters()'
            class='border-gray-300 text-black focus:ring-gray-900'
          >
          <span class='text-sm text-gray-700'
            >Out Of Stock (<span x-text='outOfStockCount'></span>)</span
          >
        </label>
      </div>
    </div>

    <button
      @click='clearFilters'
      class='w-full bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium py-2 px-4 rounded transition-colors duration-200'
    >
      Clear Filters
    </button>
  </div>
</div>

<script>
  window.__filterMeta = window.__filterMeta || {}
  window.__filterMeta.productTypes = [
    {% assign pt = collection.filters | where: 'param_name', 'filter.p.product_type' | first %}
    {% if pt and pt.values %}
      {% for v in pt.values %}
        { value: {{ v.value | json }}, count: {{ v.count | default: 0 }} }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    {% endif %}
  ]
  window.__filterMeta.availability = {
    {% assign av = collection.filters | where: 'param_name', 'filter.v.availability' | first %}
    {% if av and av.values %}
      {% for v in av.values %}
        {% if v.value == '1' or v.value == true %}
          in: {{ v.count | default: 0 }},
        {% elsif v.value == '0' or v.value == false %}
          out: {{ v.count | default: 0 }},
        {% endif %}
      {% endfor %}
    {% endif %}
  }
</script>
<script>
  document.addEventListener('alpine:init', () => {
    Alpine.data('collectionFilters', () => ({
      // Parent filters = Product Type (fixed allowlist)
      PARENT_TYPES: ['Accessories', 'Apparel', 'Ultralight Knives'],

      filtersOpen: {
        productType: true,
        availability: true,
      },
      selectedFilters: {
        productTypeSelected: '',
        groupTagSelected: '',
        availabilitySelected: '',
      },
      productTypes: [],
      groupTags: [],
      isInitializing: true,

      titleCase(str) {
        try {
          return String(str || '')
            .toLowerCase()
            .split(/\s+/)
            .map(w => w.charAt(0).toUpperCase() + w.slice(1))
            .join(' ')
        } catch (e) {
          return str
        }
      },

      toHandleSafe(val) {
        try {
          return String(val || '')
            .toLowerCase()
            .trim()
            .replace(/[^a-z0-9]+/g, '-')
            .replace(/^-+|-+$/g, '')
        } catch (e) {
          return ''
        }
      },

      normalizeType(val) {
        return String(val || '')
          .toLowerCase()
          .trim()
          .replace(/[_-]+/g, ' ')
          .replace(/\s+/g, ' ')
      },

      matchesParentType(productType, parentValue) {
        const a = this.normalizeType(productType)
        const b = this.normalizeType(parentValue)
        if (!a || !b) return false
        if (a === b) return true
        if (this.toHandleSafe(a) === this.toHandleSafe(b)) return true
        return false
      },

      isParentSelected(typeValue) {
        return this.matchesParentType(
          this.selectedFilters.productTypeSelected,
          typeValue
        )
      },

      isGroupTagSelected(tag) {
        const sel = this.selectedFilters.groupTagSelected
        if (!sel || !tag) return false
        if (sel === tag.tag) return true
        return this.toHandleSafe(sel) === tag.handle
      },

      isAllowedParent(val) {
        const n = this.normalizeType(val)
        return this.PARENT_TYPES.some(p => this.normalizeType(p) === n)
      },

      /**
       * "Hat Group" → { tag: "Hat Group", label: "Hat", handle: "hat-group" }
       */
      parseGroupTag(raw) {
        const s = String(raw || '').trim()
        if (!s) return null
        const parts = s.split(/\s+/).filter(Boolean)
        if (parts.length < 2) return null
        if (parts[parts.length - 1].toLowerCase() !== 'group') return null
        const label = this.titleCase(parts.slice(0, -1).join(' '))
        if (!label) return null
        return {
          tag: s,
          label,
          handle: this.toHandleSafe(s),
        }
      },

      /** /collections/{handle} or /collections/{handle}/{tag-handle} */
      getCollectionParts() {
        const path = window.location.pathname || ''
        const m = path.match(/\/collections\/([^\/]+)(?:\/([^\/]+))?/i)
        return {
          handle: m && m[1] ? decodeURIComponent(m[1]) : 'all',
          tagHandle: m && m[2] ? decodeURIComponent(m[2]) : '',
        }
      },

      async init() {
        sessionStorage.removeItem('kk_allProductTypes')
        sessionStorage.removeItem('kk_apparelTagsAll')

        this.buildProductTypes()
        this.hydrateFromUrl()
        await this.buildGroupTags()

        this.isInitializing = false
      },

      buildProductTypes() {
        try {
          const meta =
            (window.__filterMeta && window.__filterMeta.productTypes) || []
          const products = window.__collectionProducts || []

          this.productTypes = this.PARENT_TYPES.map(canonical => {
            const metaHit = meta.find(t =>
              this.matchesParentType(t.value, canonical)
            )
            const value = metaHit ? String(metaHit.value) : canonical
            let count = metaHit ? Number(metaHit.count || 0) : 0
            if (!count && products.length) {
              count = products.filter(p =>
                this.matchesParentType(p.product_type || p.type, canonical)
              ).length
            }
            return { value, count }
          })
        } catch (e) {
          this.productTypes = this.PARENT_TYPES.map(value => ({
            value,
            count: 0,
          }))
        }
      },

      groupTagsCacheKey(typeValue) {
        return `kk_groupTags_v2_${this.toHandleSafe(typeValue)}`
      },

      collectGroupTagsFromProducts(products, typeValue, map) {
        ;(products || []).forEach(p => {
          if (!this.matchesParentType(p.product_type || p.type, typeValue)) {
            return
          }
          ;(p.tags || []).forEach(tag => {
            const parsed = this.parseGroupTag(tag)
            if (!parsed) return
            if (!map[parsed.tag]) map[parsed.tag] = parsed
          })
        })
      },

      readCachedGroupTags(typeValue) {
        try {
          const raw = sessionStorage.getItem(this.groupTagsCacheKey(typeValue))
          if (!raw) return []
          const arr = JSON.parse(raw)
          return Array.isArray(arr) ? arr : []
        } catch (e) {
          return []
        }
      },

      writeCachedGroupTags(typeValue, tags) {
        try {
          if (!typeValue || !tags || !tags.length) return
          sessionStorage.setItem(
            this.groupTagsCacheKey(typeValue),
            JSON.stringify(tags)
          )
        } catch (e) {
          // ignore quota / private mode
        }
      },

      applyGroupTagMap(map, typeValue) {
        const active = this.selectedFilters.groupTagSelected
        if (active) {
          const parsed = this.parseGroupTag(active)
          const activeHandle = this.toHandleSafe(active)
          const exists = Object.keys(map).some(k => {
            const t = map[k]
            return (
              t.tag === active ||
              t.handle === activeHandle ||
              (parsed && t.tag === parsed.tag)
            )
          })
          if (!exists) {
            const fallback =
              parsed ||
              ({
                tag: active,
                label: this.titleCase(
                  String(active).replace(/\s+group$/i, '').trim()
                ),
                handle: activeHandle,
              })
            map[fallback.tag] = fallback
          }
        }

        this.groupTags = Object.values(map).sort((a, b) =>
          String(a.label).localeCompare(String(b.label))
        )

        // Cache whenever we have more than the single active tag
        if (this.groupTags.length > 1 || !active) {
          this.writeCachedGroupTags(typeValue, this.groupTags)
        }
      },

      async fetchCatalogProducts() {
        try {
          const loc = new URL(window.location.href)
          const preview = loc.searchParams.get('preview_theme_id')
          const fetchUrl = preview
            ? `/collections/all/products.json?limit=250&preview_theme_id=${encodeURIComponent(preview)}`
            : '/collections/all/products.json?limit=250'
          const res = await fetch(fetchUrl, {
            credentials: 'same-origin',
            headers: { Accept: 'application/json' },
          })
          if (!res.ok) return []
          const data = await res.json()
          return (data && data.products) || []
        } catch (e) {
          return []
        }
      },

      /**
       * Build ALL Group subfilters for the selected product type.
       * Catalog tags are the source of truth so a renamed Group drops the old name.
       * Cache is only a first-paint placeholder (filtered pages only have one Group).
       */
      async buildGroupTags() {
        try {
          const selected = this.selectedFilters.productTypeSelected
          if (!selected || !this.isAllowedParent(selected)) {
            this.groupTags = []
            return
          }

          const pageProducts = window.__collectionProducts || []

          // 1) First paint: current page + cache so other Groups do not vanish
          const preview = {}
          this.readCachedGroupTags(selected).forEach(t => {
            if (t && t.tag) preview[t.tag] = t
          })
          this.collectGroupTagsFromProducts(pageProducts, selected, preview)
          this.applyGroupTagMap(preview, selected)

          // 2) Replace with live catalog tags (do not merge stale cache names)
          const catalog = await this.fetchCatalogProducts()
          if (catalog.length) {
            const live = {}
            this.collectGroupTagsFromProducts(catalog, selected, live)
            this.collectGroupTagsFromProducts(pageProducts, selected, live)
            this.applyGroupTagMap(live, selected)
          }
        } catch (e) {
          this.groupTags = []
        }
      },

      resolveGroupTagFromHandle(tagHandle) {
        if (!tagHandle) return ''
        const handle = this.toHandleSafe(tagHandle)
        const products = window.__collectionProducts || []
        for (let i = 0; i < products.length; i++) {
          const tags = products[i].tags || []
          for (let j = 0; j < tags.length; j++) {
            const parsed = this.parseGroupTag(tags[j])
            if (parsed && parsed.handle === handle) return parsed.tag
          }
        }
        // Fallback: hat-group → "Hat Group"
        return this.titleCase(String(tagHandle).replace(/-/g, ' '))
      },

      hydrateFromUrl() {
        try {
          const url = new URL(window.location.href)
          const parts = this.getCollectionParts()

          const types = (
            url.searchParams.getAll('filter.p.product_type') || []
          ).filter(t => this.isAllowedParent(t))

          if (types.length) {
            const match = (this.productTypes || []).find(pt =>
              this.matchesParentType(pt.value, types[0])
            )
            this.selectedFilters.productTypeSelected = match
              ? match.value
              : types[0]
          } else if (parts.handle && parts.handle !== 'all') {
            const matchType = (this.productTypes || []).find(pt => {
              const typeHandle = this.toHandleSafe(pt.value)
              if (typeHandle === parts.handle) return true
              if (typeHandle.endsWith('-' + parts.handle)) return true
              if (
                parts.handle.endsWith('s') &&
                typeHandle === parts.handle.slice(0, -1)
              )
                return true
              return false
            })
            if (matchType) {
              this.selectedFilters.productTypeSelected = matchType.value
            }
          }

          // Infer parent from products when on a tag URL without product_type
          if (
            !this.selectedFilters.productTypeSelected &&
            (window.__collectionProducts || []).length
          ) {
            const typeCounts = {}
            ;(window.__collectionProducts || []).forEach(p => {
              const t = String(p.product_type || p.type || '').trim()
              if (!this.isAllowedParent(t)) return
              typeCounts[t] = (typeCounts[t] || 0) + 1
            })
            const top = Object.keys(typeCounts).sort(
              (a, b) => typeCounts[b] - typeCounts[a]
            )[0]
            if (top) {
              const match = (this.productTypes || []).find(pt =>
                this.matchesParentType(pt.value, top)
              )
              this.selectedFilters.productTypeSelected = match
                ? match.value
                : top
            }
          }

          const avParam = url.searchParams.get('filter.v.availability')
          if (avParam !== null) {
            if (String(avParam) === '1') {
              this.selectedFilters.availabilitySelected = 'in-stock'
            } else if (String(avParam) === '0') {
              this.selectedFilters.availabilitySelected = 'out-of-stock'
            }
          }

          // Subfilter from native tag path: /collections/all/hat-group
          if (parts.tagHandle) {
            this.selectedFilters.groupTagSelected =
              this.resolveGroupTagFromHandle(parts.tagHandle)
          } else {
            // Legacy query param support
            const tagParam = url.searchParams.get('filter.p.tag')
            if (tagParam) {
              this.selectedFilters.groupTagSelected = tagParam
            }
          }
        } catch (e) {
          // ignore
        }
      },

      onParentTypeChange() {
        this.selectedFilters.groupTagSelected = ''
        this.selectedFilters.availabilitySelected = ''
        this.applyFilters(true)
      },

      toggleGroupTag(tag, checked) {
        this.selectedFilters.groupTagSelected = checked ? tag : ''
        this.applyFilters()
      },

      toggleFilter(filterName) {
        this.filtersOpen[filterName] = !this.filtersOpen[filterName]
      },

      clearFilters() {
        this.selectedFilters = {
          productTypeSelected: '',
          groupTagSelected: '',
          availabilitySelected: '',
        }
        this.groupTags = []
        this.applyFilters()
      },

      get inStockCount() {
        const meta = window.__filterMeta || {}
        if (meta.availability && typeof meta.availability.in === 'number') {
          return meta.availability.in
        }
        const products = window.__collectionProducts || []
        return products.filter(p => p.available).length
      },

      get outOfStockCount() {
        const meta = window.__filterMeta || {}
        if (meta.availability && typeof meta.availability.out === 'number') {
          return meta.availability.out
        }
        const products = window.__collectionProducts || []
        return products.filter(p => !p.available).length
      },

      applyFilters(productTypeChanged = false) {
        if (this.isInitializing) return

        if (productTypeChanged) {
          this.selectedFilters.availabilitySelected = ''
          this.selectedFilters.groupTagSelected = ''
        }

        const url = new URL(window.location.href)
        url.searchParams.delete('page')
        // Tag filtering uses the collection path, not filter.p.tag
        url.searchParams.delete('filter.p.tag')

        const selected = this.selectedFilters.productTypeSelected || ''
        const groupTag = this.selectedFilters.groupTagSelected || ''

        // Parent = product type on /collections/all so shoppers see ALL of that type
        url.searchParams.delete('filter.p.product_type')
        if (selected && this.isAllowedParent(selected)) {
          url.searchParams.append('filter.p.product_type', selected)
          if (groupTag) {
            // Subfilter = native Shopify tag URL
            url.pathname = `/collections/all/${this.toHandleSafe(groupTag)}`
          } else {
            url.pathname = '/collections/all'
          }
        } else {
          // Cleared parent — leave tag path too
          url.pathname = '/collections/all'
        }

        // Availability
        url.searchParams.delete('filter.v.availability')
        const availabilitySelected =
          this.selectedFilters.availabilitySelected || ''
        if (availabilitySelected === 'in-stock') {
          url.searchParams.append('filter.v.availability', '1')
        } else if (availabilitySelected === 'out-of-stock') {
          url.searchParams.append('filter.v.availability', '0')
        }

        const nextUrl = url.toString()
        if (nextUrl === window.location.href) return
        window.location.href = nextUrl
      },
    }))
  })
</script>
